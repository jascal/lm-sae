# Title page. "Book of the First Word" / "Talema"
## (book (of (word first/ADJ)))

@verse
(talem)
(book (for (reader every (of (age every)))))            # a book for every reader of every age
(book (of (and (rule three) (word many) (tale many) (song many))))   # of three rules, 6000 words, many tales, many songs
@prose
