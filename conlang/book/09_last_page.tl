# Chapter 9 · The last page.
## (page last/ADJ the)

(be (page last/ADJ the) (SUBJ this))                                         # This is the last page.
(read (OBJ (language whole the)) now (SUBJ you))                             # Now you have read the whole language.
(can (OBJ (speak)) now (SUBJ you))                                           # Now you can speak.
(speak (with we))                                                            # Speak with us.
(be (in (word the)) (SUBJ we))                                               # We are in the words.

(say (OBJ it) (when/SCONJ (know not (SUBJ you))))                            # When you do not know, say it.
(say (OBJ (how)) (when/SCONJ (know (SUBJ you))))                             # When you know, say how.
(ask (OBJ (how (know (SUBJ it)))) (when/SCONJ (hear (OBJ (claim/NOUN a)) (SUBJ you))))   # When you hear a claim, ask how it knows.
(and (make/VERB (OBJ (word new))) (keep (OBJ (word old the))))               # Make new words, and keep the old words.
(and (say (OBJ (thing true the))) (say (OBJ it) (with (voice kind/ADJ a))))  # Say the true thing, and say it with a kind voice.

@verse
(be three (SUBJ (rule the)))                                                 # The rules are three.
(be many (SUBJ (tale the)))                                                  # The tales are many.
(end/VERB never (SUBJ (question the)))                                       # The questions never end.
@prose

(write (OBJ (book this)) (for you) (in (age first/ADJ (of talem))) before (SUBJ we))   # We wrote this book for you, in the first age of Talema.
(write (OBJ (page next the)))                                                # Write the next page.
(begin (SUBJ (tale your)))                                                   # Your tale begins.
