# Tale 1 · The leaf who had no children (Grimm). Why every sentence ends in "a".
## (leaf (that (have (OBJ (child no)))) the)

(be (tree (of word) a) once (SUBJ there))                                    # Once there was a tree of words.
(stand (on (top (of (tree the)))) (SUBJ (head the)))                         # At the top of the tree stood the head.
(have (OBJ (child four)) (SUBJ (head the)))                                  # The head had four children.
(and (say (OBJ (vowel "u")) (SUBJ it)) (be proud (SUBJ it)))                 # It said "u", and it was proud.
(hang (below (head the)) (SUBJ (word many)))                                 # Below the head hung many words.
(have (OBJ (child two)) (SUBJ (word some)))                                  # Some words had two children.
(have (OBJ (child one/NUM)) (SUBJ (word other/DET)))                         # Other words had one child.
(hang (at (end/NOUN (of (branch the)) the)) (SUBJ (leaf small a)))           # At the end of the branch hung a small leaf.
(have (OBJ (child no)) (SUBJ (leaf the)))                                    # The leaf had no children.
(be (vowel "a") (SUBJ (ending its)))                                         # Its ending was "a".

(be sad (SUBJ (leaf the)))                                                   # The leaf was sad.
(say (OBJ (be (word small most the) (SUBJ I))) (SUBJ it))                    # It said: I am the smallest word.
(say (OBJ (hold (OBJ nothing) (SUBJ I))) (SUBJ it))                          # I hold nothing.
(say (OBJ (be zero (SUBJ (ending my)))) (SUBJ it))                           # My ending is zero.
(say (OBJ (hold (OBJ four) (SUBJ (head the)))) (SUBJ it))                    # The head holds four.

(come (to (tree the)) (SUBJ (wind the)))                                     # The wind came to the tree.
(ask (OBJ (be sad why (SUBJ you))) (SUBJ (wind the)))                        # The wind asked: why are you sad?
(say (OBJ (and (hold (OBJ four) (SUBJ (head the))) (hold (OBJ nothing) (SUBJ I)))) (SUBJ (leaf the)))   # The head holds four and I hold nothing.
(say (OBJ (listen (to (tree the)) (when/SCONJ (speak (SUBJ it))))) (SUBJ (wind the)))   # The wind said: listen to the tree when it speaks.

(speak (OBJ (sentence a)) (SUBJ (tree the)))                                 # The tree spoke a sentence.
(speak first/ADV (SUBJ (head the)))                                          # The head spoke first.
(speak then (with (child all its)) (SUBJ (child first/ADJ its)))          # Then its first child spoke, with all its children,
(speak then (with (child all its)) (SUBJ (child next the)))                  # then the next child, with all its children.
(and (speak last/ADV (SUBJ (leaf the))) (say (OBJ (vowel "a")) (SUBJ it)))   # And last the leaf spoke, and it said "a".
(be silent then (SUBJ (tree the)))                                           # Then the tree was silent.
(finish (SUBJ (sentence the)))                                               # The sentence was finished.

(ask (OBJ (know (OBJ (whether (finish (SUBJ (sentence the))))) (SUBJ who))) (SUBJ (wind the)))   # The wind asked: who knows whether the sentence is finished?
(say (OBJ (know (OBJ it) not (SUBJ (head the)))) (SUBJ (wind the)))          # The head does not know it.
(say (OBJ (say (OBJ it) (SUBJ you))) (SUBJ (wind the)))                      # You say it.
(say (OBJ (end/VERB (with you) (SUBJ (sentence every)))) (SUBJ (wind the)))  # Every sentence ends with you.
(say (OBJ (have (OBJ (end/NOUN no)) (without you) (SUBJ (tale the)))) (SUBJ (wind the)))   # Without you the tale has no end.

(understand (OBJ it) then (SUBJ (leaf the)))                                 # Then the leaf understood it.
(hold (OBJ nothing) still (SUBJ it))                                         # It still held nothing,
(but (be sad not (SUBJ it)))                                                 # but it was not sad.
(be (word last/ADJ the) (in (sentence every)) (SUBJ it))                     # It was the last word in every sentence.
(say (OBJ (vowel "a")) (at (end/NOUN (of (tale every)) the)) (SUBJ it))      # It said "a" at the end of every tale.

@tree
(end/VERB (in (vowel "a")) since (SUBJ (sentence every (of talem))))         # Since then every sentence of Talema ends in "a".
(and (be small (SUBJ (word last/ADJ the))) (end/VERB nothing (without it)))  # The last word is small, and without it nothing ends.
