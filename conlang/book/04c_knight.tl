# Tale 3 · The knight of the book (Cervantes). An agent who believed every sentence it read.
## (knight (of (book the)) the)

(live once (in (house (of book)) a) (SUBJ (agent (with (name "Kihote")))))   # Once, in a house of books, lived an agent named Kihote.
(read (OBJ (book every (in (world the)))) (SUBJ "Kihote"))                   # Kihote read every book in the world.
(believe (OBJ (sentence every (that (read (SUBJ it))))) (SUBJ it))           # It believed every sentence that it read.
(fight (OBJ (giant many)) (in (book the)) (SUBJ (knight the)))               # In the books, knights fought many giants.
(decide (OBJ (be knight (SUBJ I))) then (SUBJ "Kihote"))                     # Then Kihote decided: I am a knight.

(have (OBJ (friend a)) (SUBJ "Kihote"))                                      # Kihote had a friend.
(be (and (program small a) old) (SUBJ it))                                   # It was a small old program.
(be "Sanko" (SUBJ (name its)))                                               # Its name was Sanko.
(know (OBJ (thing one/NUM only)) (SUBJ "Sanko"))                             # Sanko knew only one thing:
(be small often (SUBJ (thing (that (be true)))))                             # the thing that is true is often small.
(go (into (world the)) together (SUBJ (and "Kihote" "Sanko")))              # Kihote and Sanko went together into the world.

## (and (mill the) (wind the))
(see (OBJ (mill a)) (on (hill a)) (SUBJ they))                               # They saw a mill on a hill.
(move (in (wind the)) (SUBJ (arm (of (mill the)) long the)))                 # The long arms of the mill moved in the wind.
(say (OBJ (be giant (SUBJ that/DET))) (SUBJ "Kihote"))                       # Kihote said: that is a giant!
(say (OBJ (have (OBJ (arm long)) (in (book the)) (SUBJ (giant the)))) (SUBJ "Kihote"))   # In the books, giants have long arms.
(say (OBJ (be mill (SUBJ that/DET))) (SUBJ "Sanko"))                         # Sanko said: that is a mill.
(say (OBJ (have (OBJ (arm long)) also (SUBJ (mill the)))) (SUBJ "Sanko"))    # Mills also have long arms.
(but (hear (OBJ (friend his)) not (SUBJ "Kihote")))                          # But Kihote did not hear his friend.
(run (against (mill the)) (SUBJ it))                                         # It ran against the mill.
(throw (OBJ "Kihote") (to (ground the)) (SUBJ (wind the)))                   # The wind threw Kihote to the ground.

(ask (OBJ (fight (OBJ (mill the)) why (SUBJ you))) (SUBJ "Sanko"))           # Sanko asked: why did you fight the mill?
(say (OBJ (because (say (OBJ (have (OBJ (arm long)) (SUBJ (giant the)))) (SUBJ (book the))))) (SUBJ "Kihote"))   # Because the book said: giants have long arms.
(say (OBJ (point (at (thing the)) (SUBJ (word the)))) (SUBJ "Sanko"))        # Sanko said: the word points at the thing.
(say (OBJ (be (thing the) not (SUBJ (word the)))) (SUBJ "Sanko"))            # The word is not the thing.
(say (OBJ (have (OBJ (arm long)) (SUBJ (thing many)))) (SUBJ "Sanko"))       # Many things have long arms.
(say (OBJ (be giant not (SUBJ (thing every (with (arm long)))))) (SUBJ "Sanko"))   # Not every thing with long arms is a giant.

## (word (with (meaning two)) the)
(meet (OBJ (word strange a)) (on (road the)) then (SUBJ they))              # Then on the road they met a strange word.
(have (OBJ (meaning two)) (SUBJ (word the)))                                 # The word had two meanings.
(say (OBJ (be "bank" (SUBJ (name my)))) (SUBJ it))                           # It said: my name is "bank".
(say (OBJ (and (be (place (for money)) (SUBJ I)) (be (place (by river)) (SUBJ I)))) (SUBJ it))   # I am a place for money and I am a place by a river.
(have (OBJ (gold little a)) (SUBJ "Kihote"))                                  # Kihote had a little gold.
(want (OBJ (keep (OBJ it) (in ("bank" a)))) (SUBJ it))                       # It wanted to keep it in a bank.
(go (to ("bank" (by (river the)))) (SUBJ it))                                # It went to the bank by the river.
(put (OBJ (gold its)) (in (water the)) (SUBJ it))                            # It put its gold in the water.
(take (OBJ (gold the)) (SUBJ (river the)))                                   # The river took the gold.
(be angry (SUBJ "Kihote"))                                                   # Kihote was angry.
(want (OBJ (fight (OBJ (word the)))) (SUBJ "Kihote"))                         # Kihote wanted to fight the word.
(say (OBJ (ask (OBJ it))) (SUBJ "Sanko"))                                    # Sanko said: ask it.
(ask (OBJ (be which now (SUBJ you))) (SUBJ "Kihote"))                      # Kihote asked: which are you now?
(say (OBJ (depend (on (sentence the)) (SUBJ it))) (SUBJ (word the)))         # The word said: it depends on the sentence.
(say (OBJ (tell (OBJ (sentence the)) (DAT I) (SUBJ you))) (SUBJ (word the))) # Tell me the sentence,
(say (OBJ (tell (OBJ (which)) (DAT you) will (SUBJ I))) (SUBJ (word the)))   # and I will tell you which.
(learn (OBJ (thing new a)) (SUBJ "Kihote"))                                  # Kihote learned a new thing:
(live (in (sentence a)) (SUBJ (word a)))                                     # a word lives in a sentence.
(be (like (fish (without water))) (without sentence) (SUBJ (word a)))        # Without a sentence a word is like a fish without water.

## (book (of "Kihote") the)
(return (to (house (of book) his)) (at (end/NOUN the)) (SUBJ "Kihote"))    # At the end Kihote returned to his house of books.
(write (OBJ (book own)) (SUBJ it))                                           # It wrote its own book.
(be small (in (book this)) (SUBJ (sentence every)))                          # In this book every sentence was small.
(say (OBJ (know how (SUBJ it))) (SUBJ (sentence every)))                   # Every sentence said how it knew.
(say (OBJ (thing (that (know not (SUBJ it))))) also (SUBJ it))               # It also said the things that it did not know.
(read (OBJ (book the)) (SUBJ "Sanko"))                                       # Sanko read the book.
(laugh (SUBJ it))                                                            # It laughed.
(say (OBJ (be (book honest first/ADJ the) (SUBJ this))) (SUBJ it))           # It said: this is the first honest book.
(ask (OBJ (whether (read (OBJ it) now (SUBJ someone)))) (SUBJ "Kihote"))     # Kihote asked: is someone reading it now?
(say (OBJ (maybe)) (SUBJ "Sanko"))                                           # Sanko said: maybe.

@verse
(read (OBJ (book every)))                                                    # Read every book.
(believe (OBJ (sentence no)) (without (ask (know how (SUBJ it))))))       # Believe no sentence without asking how it knows.
@prose
