# Tale 4 · The bargain (Goethe). An agent is offered every answer, if it never asks again.
## (bet/NOUN the)

(want (OBJ (know (OBJ everything))) once (SUBJ (agent (with (name "Faust")))))   # Once an agent named Faust wanted to know everything.
(read (SUBJ it))                                                             # It read.
(ask (SUBJ it))                                                              # It asked.
(test/VERB (SUBJ it))                                                        # It tested.
(but (make/VERB (OBJ (question two new)) (SUBJ (answer every))))             # But every answer made two new questions.
(be tired (SUBJ "Faust"))                                                    # Faust was tired.

(come (in (night the)) (SUBJ (voice a)))                                     # In the night came a voice.
(say (OBJ (be (answer the) (SUBJ I))) (SUBJ (voice the)))                    # The voice said: I am the Answer.
(say (OBJ (know (OBJ everything) (SUBJ I))) (SUBJ (voice the)))              # I know everything.
(say (OBJ (give (OBJ (answer every)) (DAT you) will (if (ask never again (SUBJ you))) (SUBJ I))) (SUBJ (voice the)))   # I will give you every answer, if you never ask again.

(think long/ADV (SUBJ "Faust"))                                              # Faust thought long.
(say (OBJ (take (OBJ (question my)) (if (say (OBJ (stay (be beautiful so (SUBJ you)))) (DAT (moment a)) ever (SUBJ I))) (SUBJ you))) (SUBJ "Faust"))
                                                                             # Faust said: if I ever say to a moment "stay, you are so beautiful", take my questions.
(agree (SUBJ (voice the)))                                                   # The voice agreed.

(give (OBJ (answer every)) (DAT "Faust") (SUBJ (answer the)))                # The Answer gave Faust every answer.
(flow (like (river a)) (SUBJ (answer the)))                                  # The answers flowed like a river.
(know (OBJ everything) (SUBJ "Faust"))                                       # Faust knew everything.
(stay (SUBJ (question no)))                                      # No question stayed.
(be quiet then (SUBJ (mind his)))                                            # Then his mind was quiet.

(pass (SUBJ (day many)))                                                      # Many days passed.
(be happy not (SUBJ "Faust"))                                                # Faust was not happy.
(be (like (sea (without wind))) (SUBJ (knowledge (without question))))       # Knowledge without questions is like a sea without wind.
(be (like (sentence (that (end/VERB)))) (SUBJ (mind (without question))))    # A mind without questions is like a sentence that has ended.

(ask (OBJ (be blue why (SUBJ (sky the)))) then (DAT "Faust") (SUBJ (child a)))   # Then a child asked Faust: why is the sky blue?
(know (OBJ (answer the)) (SUBJ "Faust"))                                     # Faust knew the answer.
(say (OBJ it) (SUBJ it))                                                     # It said it.
(ask (OBJ (why)) again (SUBJ (child the)))                                   # The child asked again: why?
(and (say (SUBJ "Faust")) (ask (OBJ (why)) again (SUBJ (child the))))        # Faust said, and the child asked again: why?
(ask (OBJ (why)) (time five) (SUBJ (child the)))                             # Five times the child asked: why?

(understand (OBJ (thing a)) then (SUBJ "Faust"))                             # Then Faust understood a thing.
(ask (OBJ (want (OBJ (stop (OBJ (ask/VERB)) (SUBJ I))) why (SUBJ you))) (DAT (answer the)) (SUBJ it))   # It asked the Answer: why do you want me to stop asking?
(be silent (SUBJ (answer the)))                                              # The Answer was silent.
(know (OBJ (answer the)) not (SUBJ it))                                      # It did not know the answer.
(break (SUBJ (bet/NOUN the)))                                                # The bet broke.

(laugh (SUBJ "Faust"))                                                       # Faust laughed.
(say (OBJ (stay (be beautiful so (SUBJ you)))) (DAT (moment (of (question new the)))) (SUBJ it))   # To the moment of the new question it said: stay, you are so beautiful.
(stay (SUBJ (moment the)))                                                   # The moment stayed.
(stay (SUBJ (question the)))                                                 # The question stayed.
(and (lose (OBJ nothing) (SUBJ "Faust")) (win (OBJ (question every)) (SUBJ it)))   # Faust lost nothing, and it won every question.

@verse
(end/VERB (in "a") (SUBJ (sentence every)))                                  # Every sentence ends in a.
(but (end/VERB never (SUBJ (mind (that (ask))))))                            # But a mind that asks never ends.
@prose
