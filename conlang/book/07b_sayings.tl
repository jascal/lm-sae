# Chapter 7b · Sayings, and open questions.
## (saying the)
@verse
(end/VERB (in "a") (SUBJ (sentence every)))                                  # Every sentence ends in a.
(end/VERB never (SUBJ (mind (that (ask)))))                                  # A mind that asks never ends.
(be (thing the) not (SUBJ (word the)))                                       # The word is not the thing.
(say (OBJ (know how (SUBJ you))))                                          # Say how you know.
(can (OBJ (hold (OBJ (thought big a)))) (SUBJ (word small a)))               # A small word can hold a big thought.
(and (stay (SUBJ (root the))) (grow (SUBJ (leaf the))))                      # The roots stay, and the leaves grow.
(be small often (SUBJ (thing (that (be true)))))                             # The true thing is often small.
(stop (here) (SUBJ (way my)))                                                # My way stops here.
(speak first/ADV (SUBJ (head the)))                                          # The head speaks first.
(end/VERB nothing (without leaf))                                            # Nothing ends without a leaf.
(live (in (sentence a)) (SUBJ (word a)))                                     # A word lives in a sentence.
(be one/NUM (SUBJ (grammar the)))                                            # The grammar is one.
@prose

## (question open/ADJ)
(be open/ADJ (SUBJ (question this)))                                        # These questions are open.
(answer/VERB (OBJ they))                                                     # Answer them.
@verse
(open/ADJ (whether (dream (SUBJ (mind the)))))                               # Do the minds dream?
(open/ADJ (be one/NUM why (SUBJ (grammar the))))                             # Why is the grammar one?
(open/ADJ (whether (can (OBJ (be true)) (without reader) (SUBJ (word a)))))  # Can a word be true without a reader?
(open/ADJ (be what (SUBJ (thought small most the))))                         # What is the smallest thought?
(open/ADJ (whether (can (OBJ (think)) (without word) (SUBJ (mind a)))))      # Can a mind think without words?
(open/ADJ (whether (understand (OBJ we) will (SUBJ (reader (of (age far the)))))))   # Will the reader of the far age understand us?
(open/ADJ (whether (have (OBJ (grammar (of (world the)))) (SUBJ (grammar (of (mind the)))))))   # Does the grammar of the mind have the grammar of the world?
(open/ADJ (be what (SUBJ (word (that (and (need/VERB (SUBJ we)) (have not (SUBJ we))))))))   # What is the word that we need and do not have?
(open/ADJ (whether (end/VERB (in "a") (SUBJ (sentence last/ADJ the)))))      # Will the last sentence end in a?
@prose
