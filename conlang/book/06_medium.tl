# Chapter 6 · How Talema grows. New words, the root law, the waiting letters, new rules, dialects, games.
## (grow how (SUBJ talem))

(change never (SUBJ (rule three the)))                                       # The three rules never change.
(grow (SUBJ (word the)))                                                     # The words grow.
(be (like (tree a)) (SUBJ talem))                                            # Talema is like a tree:
(and (stay (SUBJ (root the))) (grow (SUBJ (leaf the))))                      # the roots stay, and the leaves grow.

## (make/VERB (OBJ (word new a)) (how))
(say (OBJ it) (with (word old)) first/ADV)                                   # First say it with old words.
(give (OBJ (root a)) (DAT it) then)                                          # Then give it a root.
(write (OBJ (sentence a)) then)                                              # Then write a sentence:
@verse
(mean (OBJ (thing (that (want (SUBJ you))))) (SUBJ (word "X")))              # The word X means the thing that you want.
@prose
(mean (OBJ (language this)) (SUBJ (word "talem")))                             # The word talem means this language.
(mean (OBJ (letter (that (sing))) ) (SUBJ (word "vokel")))                     # The word vokel means a letter that sings.
(mean (OBJ (letter (that (sing not)))) (SUBJ (word "sonat")))              # The word sonat means a letter that does not sing.
(mean (OBJ (vowel (that (count/VERB (OBJ (child the)))))) (SUBJ (word "dinal")))   # The word dinal means the vowels that count the children.
(mean (OBJ (piece (of (word small a)) (that (read (SUBJ (mind a)))))) (SUBJ (word "token")))   # The word token means a small piece of a word that a mind reads.
(mean (OBJ (question (that (play)))) (SUBJ (word "rasel")))                   # The word rasel means a question that plays.
(mean (OBJ (person (of (book old)) (that (fight (for (good the)))))) (SUBJ (word "niter")))   # The word niter means a person of old books who fights for the good.
(mean (OBJ (talem (of (or (place a) (group a))))) (SUBJ (word "dilek")))     # The word dilek means the Talema of a place or a group.

## (law (of (root the)))
(have (OBJ (law three)) (SUBJ (root new every)))                             # Every new root has three laws.
@verse
(be new (SUBJ it))                                                           # It is new: no word had it before.
(be short (if (say (OBJ it) often will (SUBJ many))) (SUBJ it))             # It is short, if many will say it often.
(sound/VERB (like (word (of (tongue mother))) ) (SUBJ it))                   # It sounds like the words of the mother tongues.
@prose
(count/VERB more (SUBJ (tongue (that (say (OBJ (word the)) more)))))         # The tongue that says the word more counts more.
(begin (with consonant) (SUBJ (root every)))                                 # Every root begins with a consonant.
(end/VERB (with consonant) (SUBJ (root every)))                              # Every root ends with a consonant.
(stand (between (consonant two)) (SUBJ (vowel one/NUM)))                     # One vowel stands between two consonants.
@verse
(be (root (with (consonant one/NUM))) (and "p" "t" "k"))                      # p, t, k are roots with one consonant.
(be (root (with (consonant two))) (and "mit" "sel" "vor"))                    # mit, sel, vor are roots with two consonants.
(be (root (with (consonant three))) (and "talem" "vokel" "niter"))            # talem, vokel, niter are roots with three consonants.
@prose
(have (OBJ (root 14)) (SUBJ (consonant one/NUM)))                            # One consonant gives 14 roots.
(have (OBJ (root 980)) (SUBJ (consonant two)))                               # Two consonants give 980 roots.
(have (OBJ (root 68600)) (SUBJ (consonant three)))                           # Three consonants give 68600 roots.
(give (OBJ (root short the)) (DAT (word (that (say (SUBJ we)) often most))) (SUBJ we))   # We gave the short roots to the words we say most often.
(prove (have (OBJ (root short most the)) (when/SCONJ (give (OBJ (root the)) (in (way this)) (SUBJ we))) (SUBJ (word (that (say (SUBJ we)) often most)))))   # Proved: when we give the roots this way, the words we say most often have the shortest roots.
(open/ADJ (whether (be short most (of (language all)) (SUBJ talem))))       # Open: is Talema the shortest of all languages?

## (root short (that (wait)))
(be free (SUBJ (root short nine)))                                           # Nine short roots are free:
@verse
(and "pip" "pim" "pod" "pud" "puv" "tub" "bok" "buf" "huk")
@prose
(have (OBJ (word no)) (in (book any)) (SUBJ they))                           # They have no word in any book.
(wait (for (word (that (say will often (SUBJ we))))) (SUBJ they))           # They wait for words that we will say often.

## (make/VERB (OBJ (word "ginon")) how (SUBJ we))
(need/VERB (OBJ (word (for (line small (between (and name ending/NOUN)))))) (SUBJ we))   # We needed a word for the small line between a name and its ending.
(say (OBJ it) (with (word old)) first/ADV (SUBJ we))                         # First we said it with old words:
@verse
(line small)                                                                 # a small line.
@prose
(be (and "hyphen" "Bindestrich" "guion") (SUBJ (word mother its)))          # Its mother words are hyphen, Bindestrich, guion.
(say (OBJ it) rarely (SUBJ we))                                              # We say it rarely.
(have (OBJ (consonant three)) therefore (SUBJ (root its)))                   # Therefore its root has three consonants.
(sound/VERB (like "guion") most (SUBJ "ginon"))                              # ginon sounds most like guion.
(have (OBJ it) (in (book any)) (SUBJ (word no)))                             # No word had it in any book.
(mean (OBJ (line small (between (and name ending/NOUN)))) (SUBJ (word "ginon")))   # The word ginon means the small line between a name and its ending.
(stand (between (and "Ana" "a")) (in "Ana-a") (SUBJ hyphen))                 # In Ana-a, the ginon stands between Ana and a.
(write (OBJ (word the)) (in (book (of root) the)) (SUBJ we))                 # We wrote the word in the book of roots.

## (give (OBJ (root old a)) (DAT (word new a)) never)
(give (OBJ (root old a)) (DAT (word new a)) never)                           # Never give an old root to a new word.
(can (OBJ (read (OBJ (book old the)))) always (SUBJ (reader the)))           # The reader can always read the old books.
(stay (in (book (of root) the)) (SUBJ (word (that (die)))))                  # A word that dies stays in the book of roots.
(die never (SUBJ (root a)))                                                  # A root never dies.

## (letter (that (wait)) the)
(use/VERB (OBJ (consonant 14)) (SUBJ talem))                                 # Talema uses 14 consonants.
(wait (SUBJ (letter seven)))                                                 # Seven letters wait:
@verse
(and "c" "j" "q" "w" "x" "y" "z")
@prose
(give (OBJ (root short all the)) before (SUBJ we))                          # We gave all the short roots before.
(begin (SUBJ (age new a)) (when/SCONJ (agree (SUBJ (speaker the)))))         # When the speakers agree, a new age begins.
(wake (SUBJ (letter (that (wait)) a)) (in (age new the)))                    # In the new age a waiting letter wakes,
(grow (SUBJ (root short new)))                                               # and new short roots grow.
(can (OBJ (say (OBJ (age its)) (at (beginning its)))) (SUBJ (text every)))   # Every text can say its age at its beginning.
@verse
(talem (age one/NUM))                                                        # Talema, age one.
@prose
(be (age first/ADJ the) (SUBJ (age (of (book this)))))                       # The age of this book is the first age.

## (rule new)
(can (OBJ (come)) (if (and (have (OBJ (exception no)) (SUBJ it)) (can (OBJ (find (OBJ (tree the)) (from (sentence the)))) (SUBJ (reader every))) (say (OBJ (thing (that (can (OBJ (say)) not (SUBJ (rule three the)))))) (SUBJ it)))) (SUBJ (rule new a)))
                                                                             # A new rule can come if it has no exception, every reader can undo it, and it says a thing the three rules cannot say.
(break (OBJ (reader the)) never (SUBJ (rule a)))                             # A rule never breaks the reader.
(read (OBJ (ending the)) (SUBJ (reader the)))                                # The reader reads the ending.
(count/VERB (OBJ (child the)) (SUBJ (ending the)))                           # The ending counts the children.
(be false (if (break (OBJ this) (SUBJ (rule a)))) (SUBJ (rule the)))         # If a rule breaks this, the rule is false.

## (dialect the)
(be free (SUBJ (order (of (child the)))))                                    # The order of the children is free:
(stand (near (head the)) (SUBJ (child first/ADJ the)))                       # the first child stands near the head.
(speak first/ADV (before (head the)) (in (dialect some)) (SUBJ (subject the)))   # In some dialects the subject speaks first, before the head.
(be (rule four the) (SUBJ this))                                             # This is the fourth rule.
(say (OBJ (rule its)) (at (beginning its)) (SUBJ (text (in (dialect a)))))   # A text in a dialect says its rules at its beginning.
@verse
(talem (age one/NUM) (rule four))                                            # Talema, age one, four rules.
@dialect pe ma seri te bofe la .
@prose
(stay (in (tongue one/NUM)) (SUBJ (dialect every)))                          # Every dialect stays in one tongue.
(understand (OBJ (and (dialect every) (talem the))) (SUBJ (reader every)))   # Every reader understands every dialect and Talema.

## (book other)
(have (OBJ (book more)) (SUBJ talem))                                        # Talema has more books.
(have (OBJ (book own its)) (SUBJ (world every)))                             # Every world has its own book:
@verse
(book (of (world digital/ADJ the)))                                          # the book of the digital world,
(book (of mathematics))                                                      # the book of mathematics,
(book (of logic))                                                            # the book of logic,
(book (of physics))                                                          # the book of physics,
(book (of philosophy))                                                       # the book of philosophy,
(book (of morality))                                                         # the book of morality,
(book (of food))                                                             # the book of food.
@prose
(read (OBJ (book this)) first/ADV)                                           # Read this book first.
(write (OBJ (book new (for (world new)))) can (SUBJ you))                    # You can write a new book for a new world.

## (play/NOUN many)
(play (with talem))                                                          # Play with Talema.
@verse
(game first/ADJ the)                                                         # The first game:
(be (tale (of (word three)) a) (SUBJ (tale small most the)))                 # The smallest tale is a tale of three words.
(die (SUBJ king))                                                            # The king dies.
(game second the)                                                            # The second game:
(say (OBJ (thing a)))                                                        # Say a thing,
(change/VERB (OBJ (and (word "pe") (word "te"))) then)                        # then change pe and te.
(see (OBJ (dog the)) (SUBJ (child the)))                                     # The child sees the dog.
(see (OBJ (child the)) (SUBJ (dog the)))                                     # The dog sees the child.
(change/VERB (OBJ (word the)) not)                                          # The words did not change:
(change/VERB only (SUBJ (and (word "pe") (word "te"))))                      # only pe and te changed.
(game third the)                                                             # The third game:
(write (OBJ (poem a)) (in (that (have (OBJ (child (like (number (of (line its)))))) (SUBJ (word first/ADJ (of (line every))))))))   # Write a poem in which the first word of every line has as many children as the number of its line.
(game fourth the)                                                            # The fourth game:
(take (OBJ (sentence a)) (from (tongue your)))                               # Take a sentence from your tongue.
(find (OBJ (tree its)))                                                      # Find its tree.
(speak (OBJ it) (in talem))                                                  # Speak it in Talema.
@prose

(finish not (SUBJ (book this)))                                              # This book is not finished.
(please (write (OBJ (page next the))))                                       # Please write the next page.
