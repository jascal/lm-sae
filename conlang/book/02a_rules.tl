# Chapter 2 · The three rules
## (rule three the)

# ── the words of the grammar: learn these first (dictionary form: root, kind, mother words) ──
## (word (of (grammar the)))
(stand first/ADV (with hyphen) alone (SUBJ (root the)))                   # The root stands first, alone, with a ginon.
(count/VERB (OBJ (child its)) (SUBJ (ending (after (hyphen the)))))      # The ending after the ginon counts its children.
@verse
("lor" noun "word" "Wort" "palabra")
("raris" noun "root" "Wurzel" "raíz")
("dinal" noun "ending" "Endung" "final")
("kid" noun "child" "Kind" "niño")
("kad" noun "head" "Kopf" "cabeza")
("lelaf" noun "leaf" "Blatt" "hoja")
("buh" noun "tree" "Baum" "árbol")
("sahen" verb "count" "zählen" "contar")
("vokel" noun "vowel" "Vokal" "vocal")
("sonat" noun "consonant" "Konsonant" "consonante")
("feras" noun "sentence" "Satz" "frase")
("rul" noun "rule" "Regel" "regla")
("p" particle "subject" "Subjekt" "sujeto")
("t" particle "object" "Objekt" "objeto")
@prose

# ── how to find a word in the book of roots (v5: readers kept failing to strip the ending) ──
## (find (OBJ (word a)) (in (book (of root) the)) how)
(remove (OBJ (vowel (after (consonant last/ADJ the)))) (from (word the)))    # Take away the vowels after the last consonant.
(be (root the) (SUBJ (thing (that (stay)))))                                 # What stays is the root.
(find (OBJ it) (in (book (of root) the)))                                    # Find it in the book of roots.
@verse
(be "mog" (SUBJ (root (of "moge"))))                                         # The root of moge is mog: morning.
(be "kin" (SUBJ (root (of "kina"))))                                         # The root of kina is kin: no.
(be "has" (SUBJ (root (of "hase"))))                                         # The root of hase is has: house.
(be "m" (SUBJ (root (of "ma"))))                                             # The root of ma is m: I.
@prose
(remove (OBJ (and hyphen (ending its))) (from (word (with hyphen))))         # From a word with a ginon, take away the ginon and its ending.

# ── names, numbers and letters: the literals (the reviews: explain the hyphen before it is used) ──
(keep (OBJ (letter own their)) (SUBJ (and name number (word (of (tongue other))))))   # Names, numbers and words of other tongues keep their own letters.
(come (after they) (SUBJ (line small a)))                                    # After them comes a small line,
(come then (SUBJ (ending their)))                                            # then their ending.
@verse
("Ana")                                                                      # Ana
(14)                                                                         # 14
("a")                                                                        # the letter a
@prose

# ── the sounds ──
(have (OBJ (and (consonant 14) (vowel five))) (SUBJ talem))              # Talema has 14 consonants and five vowels.
@verse
(be (consonant (and "p" "t" "k" "b" "d" "g" "m" "n" "l" "r" "s" "f" "v" "h")) (SUBJ they))
(be (vowel (and "a" "e" "i" "o" "u")) (SUBJ they))
# Each vowel has a spoken name, so a reader can hear a letter named without seeing it written.
@verse
(call (vowel-first) (vowel first/ADJ))                                # vanam is the name of the first vowel
(call (vowel-second) (vowel second/ADJ))                              # venam is the name of the second vowel
(call (vowel-third) (vowel third/ADJ))                                # vinam is the name of the third vowel
(call (vowel-fourth) (vowel fourth/ADJ))                              # vonam is the name of the fourth vowel
(call (vowel-fifth) (vowel fifth/ADJ))                                # vunam is the name of the fifth vowel
@prose
(sound/VERB (like (letter (of "Español"))) (SUBJ (letter the)))          # The letters sound like the letters of Spanish.
(carry (OBJ (weight/NOUN the)) (SUBJ (vowel first/ADJ (of (root the)))))  # The first vowel of the root carries the weight.
(sing (with (voice soft a)) (SUBJ (ending the)))                        # The ending sings with a soft voice.
@verse
(sound/VERB (like (and "go" "gato")) always (SUBJ "g"))                  # g always sounds as in go, gato.
(sound/VERB (like (and "house" "Haus")) (SUBJ "h"))                      # h sounds as in house, Haus.
(sound/VERB (like "voice") (SUBJ "v"))                                   # v sounds as in voice.
(sound/VERB (like "pero") short (SUBJ "r"))                              # r is short, as in pero.
@prose
(carry (OBJ (weight/NOUN no)) (SUBJ (word (with (consonant one/NUM)))))  # Words with one consonant (pe, te, la, ne) carry no weight.
(lean (on (word next the)) (SUBJ they))                                  # They lean on the next word;
(lean (on (word (before it))) (at (end/NOUN (of sentence))) (SUBJ it))    # at the end of a sentence, on the word before it.
(be (syllable own its) (SUBJ (vowel every)))                             # Every vowel is its own syllable:
(say (OBJ (vowel two)) (as (syllable two)) (when/SCONJ (stand together (SUBJ they))))   # when two vowels stand together, say them as two syllables.
(say (OBJ (ending the)) small never)                                     # Never say the ending small:
(carry (OBJ (number the)) (SUBJ it))                                     # it carries the number.
(be silent (SUBJ hyphen))                                                # The ginon is silent:
(say (OBJ (ending its)) alone (SUBJ (word (with hyphen))))               # a word with a ginon says its ending alone: Ana a.
(be (pause a) (SUBJ point))                                              # The point is a pause.
(begin (with consonant) (SUBJ (root every (of talem))))                  # Every root of Talema begins with a consonant.
(begin not (with consonant) always (SUBJ (and name number)))             # Names and numbers do not always.
(end/VERB (with vowel) (SUBJ (word every)))                              # Every word ends with a vowel.
(have (OBJ (and (root a) (ending a))) (SUBJ (word every)))         # Every word has a root and an ending.

# ── rule three: the ending counts ──
## (rule (of (ending the)))
@verse
(be zero (SUBJ (vowel "a")))                                             # a is zero
(be one/NUM (SUBJ (vowel "e")))                                          # e is one
(be two (SUBJ (vowel "i")))                                              # i is two
(be three (SUBJ (vowel "o")))                                            # o is three
(be four (SUBJ (vowel "u")))                                             # u is four
@prose
(count/VERB (OBJ (child (of (word the)))) (SUBJ (ending the)))       # The ending counts the children of the word.
(hang (from (word the)) (SUBJ (child the)))                              # The children hang from the word.
(tell (OBJ (and time number person (kind/NOUN (of word)))) never (SUBJ (ending the)))   # The ending never tells time, number, person or the kind of the word.
(count/VERB (OBJ (child the)) only (SUBJ it))                            # It only counts the children.
@verse
(eat (SUBJ (dog the)))                                                   # The dog eats: mate, one child.
(eat (OBJ bread) (SUBJ (dog the)))                                       # The dog eats bread: mati, two children.
@prose
(be same (SUBJ (and (word "mate") (word "mati"))))                       # mate and mati are the same word:
(count/VERB (OBJ (child more)) only (SUBJ (word "mati")))                 # mati only counts more children.

@verse
("Ana")                                                                  # Ana.
(sleep (SUBJ "Ana"))                                                     # Ana sleeps.
(see (OBJ (sun the)) (SUBJ "Ana"))                                       # Ana sees the sun.
(see (OBJ (sun the)) now (SUBJ "Ana"))                                   # Ana sees the sun now.
(see (OBJ (sun the)) now (in (world the)) (SUBJ "Ana"))                  # Ana sees the sun now in the world.
@prose
@tree
(see (OBJ (sun the)) now (in (world the)) (SUBJ "Ana"))

(have (OBJ (child four)) (SUBJ (word first/ADJ the)))                    # The first word has four children.
(be "u" therefore (SUBJ (ending its)))                                   # Therefore its ending is u.
(have (OBJ (child no)) (SUBJ "Ana"))                                     # Ana has no children.
(be "a" therefore (SUBJ (ending her)))                                   # Therefore her ending is a.

@verse
(be five (SUBJ (vowel "ea")))                                            # ea is five
(be six (SUBJ (vowel "ee")))                                             # ee is six
(be seven (SUBJ (vowel "ei")))                                           # ei is seven
(be ten (SUBJ (vowel "ia")))                                             # ia is ten
@prose
(count/VERB (like (hand (of person))) (SUBJ (vowel the)))                # The vowels count like the hand of a person.
(count/VERB (OBJ one/NUM) (SUBJ (vowel last/ADJ the)))                   # The last vowel counts ones.
(count/VERB (OBJ five) (SUBJ (vowel (before it))))                       # The vowel before it counts fives.
(count/VERB (OBJ 25) (SUBJ (vowel (before that/DET))))                   # The vowel before that counts twenty-fives.
@verse
(be seven (because (and (be (five one/NUM) (SUBJ "e")) (be two (SUBJ "i")))) (SUBJ "ei"))   # ei is seven: e is one five, i is two.
(be ten (because (and (be (five two) (SUBJ "i")) (be zero (SUBJ "a")))) (SUBJ "ia"))   # ia is ten: i is two fives, a is zero.
(be 24 (SUBJ "uu"))                                                      # uu is 24.
(be 25 (SUBJ "eaa"))                                                     # eaa is 25.
@prose

# ── why every sentence ends in a ──
## (end/VERB (in "a") why (SUBJ (sentence every)))
(have (OBJ (child no)) (SUBJ (word last/ADJ (of (sentence every)) the)))   # The last word of every sentence has no children.
(be "a" therefore (SUBJ (ending its)))                                   # Therefore its ending is a.
(end/VERB (in "a") therefore (SUBJ (sentence every)))                    # Therefore every sentence ends in a.
(be leaf (SUBJ (word (with (child no)))))                                # A word with no children is a leaf.
(end/VERB (with leaf) (SUBJ (tree every)))                               # Every tree ends with a leaf.
(need/VERB (OBJ point) not (SUBJ talem))                                 # Talema does not need a point (full stop).
(stand (on (leaf every)) (SUBJ (ending "a")))                               # The ending a stands on every leaf, not only on the last word.
(end/VERB (when/SCONJ (be full (SUBJ (tree the)))) (SUBJ (sentence the)))    # The sentence ends when its tree is full.
(know (OBJ it) how (SUBJ you))                                             # How do you know it?
@verse
(begin (with one/NUM))                                                       # Begin with one.
(take (OBJ one/NUM) (at (word every)))                                       # At every word, take one away,
(add (OBJ (child its)))                                                      # and add its children.
(end/VERB (when/SCONJ (be zero (SUBJ (number the)))) (SUBJ (sentence the)))  # When the number is zero, the sentence ends.
@prose
@tree
(see (OBJ (sun the)) (SUBJ "Ana"))                                           # 1 → seri: 1-1+2=2 → te: 2 → bofe: 2 → la: 1 → pe: 1 → Ana-a: 0

# ── rule two: the head speaks first ──
## (rule (of (order the)))
(speak first/ADV (SUBJ (head the)))                                      # The head speaks first.
(follow then (SUBJ (child its)))                                         # Then its children follow.
(speak (OBJ (child all its)) (before (child next the)) (SUBJ (child every)))   # Every child speaks all its children before the next child speaks.
(come first/ADV often (SUBJ (object the)))                               # Often the object comes first,
(come then (SUBJ (word other the)))                                      # then the other words,
(come last/ADV often (SUBJ (subject the)))                               # and the subject last.
(speak never (after (child its)) (SUBJ (head a)))                        # A head never speaks after its children.

# ── rule one: small words tie ──
## (rule (of (link/NOUN the)))
@verse
(see (OBJ (dog the)) (SUBJ (child the)))                                 # The child sees the dog.
(see (OBJ (child the)) (SUBJ (dog the)))                                 # The dog sees the child.
@prose
(be same (SUBJ (word the)))                                              # The words are the same.
(be different (SUBJ (and (word "pe") (word "te"))))                        # "pa" and "ta" are different.
(stand (before (subject the)) (SUBJ (word "pe")))                        # "pa" stands before the subject.
(stand (before (object the)) (SUBJ (word "te")))                          # "ta" stands before the object.

@verse
(sleep (in (house the)) (SUBJ (dog the)))                                # The dog sleeps in the house.
(sleep (behind (house the)) (SUBJ (dog the)))                            # The dog sleeps behind the house.
(sleep (with (child the)) (SUBJ (dog the)))                              # The dog sleeps with the child.
@prose
(stand (before (word (that (link/VERB (SUBJ they))))) (SUBJ (word small the)))   # The small words stand before the words that they tie.
(link/VERB (OBJ (and (dog the) (house the))) (SUBJ (word "n")))            # The word "in" ties the dog and the house.

@tree
(be four (SUBJ (and two two)))                                           # Two and two are four.
(link/VERB (OBJ (and two two)) (SUBJ (word "s")))                         # The word "and" ties two and two.
(stand first/ADV (SUBJ (word "s")))                                      # The word "and" stands first.

# ── the three rules in three sentences ──
## (rule three the (in (sentence three)))
@verse
(stand (before (subject the)) (SUBJ (word "pe")))
(speak first/ADV (SUBJ (head the)))
(count/VERB (OBJ (child the)) (SUBJ (ending the)))
@prose
(be (grammar whole the) (SUBJ this))                                     # This is the whole grammar.
(need/VERB (OBJ (thing other)) not (SUBJ you))                           # You need nothing else.
