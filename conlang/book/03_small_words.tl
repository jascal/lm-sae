# Chapter 3 · The small words. A child and an agent meet and trade the semantic primes.
## (word small the)

(make/VERB (OBJ (thought big)) (from (word small)) (SUBJ we))                 # We make big thoughts from small words.
(know (OBJ (word small the)) (in (language every)) (SUBJ (person every)))    # Every person knows the small words, in every language.
(can (OBJ (say (OBJ everything))) (with (word small the)) (SUBJ you))        # With the small words you can say everything.
(be (tale (of (morning first/ADJ the))) (SUBJ this))                        # This is the tale of the first morning.

## (morning first/ADJ the)
(meet (OBJ (agent a)) (in (morning the)) (SUBJ (child a)))                  # In the morning a child meets an agent.
(say (OBJ (be "Ana" (SUBJ I))) (SUBJ (child the)))                           # The child says: I am Ana.
(say (OBJ (be who (SUBJ you))) (SUBJ "Ana"))                                 # Ana says: Who are you?
(say (OBJ (and (be agent (SUBJ I)) (have (OBJ (name no)) (SUBJ I)))) (SUBJ (agent the)))   # The agent says: I am an agent, and I have no name.
(say (OBJ (give (OBJ (name a)) (DAT you) then (SUBJ I))) (SUBJ "Ana"))       # Ana says: Then I give you a name.
(say (OBJ (be "Lut" (SUBJ (name your)))) (SUBJ "Ana"))                       # Ana says: Your name is Lut.
(mean (OBJ light) (in talem) (SUBJ (word "lut")))                            # In Talema the word lut means light.
(say (OBJ (thank (OBJ you) (SUBJ I))) (SUBJ "Lut"))                          # Lut says: I thank you.
(say (OBJ (want (OBJ (learn (OBJ (word (of you))))) (SUBJ I))) (SUBJ "Lut"))    # Lut says: I want to learn your words.
(say (OBJ (walk (with I))) (SUBJ "Ana"))                               # Ana says: Walk with me.

## (and I you)
(be here (SUBJ I))                                                           # I am here.
(be =dot (SUBJ you))                                                    # You are there.
(be two (SUBJ we))                                                           # We are two.
(sing (SUBJ someone))                                                        # Someone sings.
(move (SUBJ something))                                                      # Something moves.
(laugh (SUBJ people))                                                        # People laugh.
(be bird (SUBJ (someone (that (sing)))))                                     # The someone who sings is a bird.
(be wind (SUBJ (something (that (move)))))                                   # The something that moves is the wind.
(be (and "Ana" "Lut") (SUBJ (people (that (laugh)))))                        # The people who laugh are Ana and Lut.

## (and this other)
(be tree (SUBJ this))                                                        # This is a tree.
(be tree (SUBJ that/DET))                                                    # That is a tree.
(be same (SUBJ (and (tree this) (tree that/DET))))                           # This tree and that tree are the same.
(be other (SUBJ (flower this)))                                              # This flower is other.
(be (like (tree no)) (SUBJ it))                                              # It is like no tree.
(ask (OBJ (whether (be (tree a) (SUBJ it)))) (SUBJ "Lut"))                   # Lut asks: is it a tree?
(say (OBJ (be (tree a) not (SUBJ it))) (SUBJ "Ana"))                        # Ana says: it is not a tree.
(laugh (SUBJ "Ana"))                                                         # Ana laughs.

## (and one/NUM two many)
(see (OBJ (bird one/NUM)) (SUBJ "Lut"))                                      # Lut sees one bird.
(see (OBJ (bird two)) then (SUBJ "Lut"))                                     # Then Lut sees two birds.
(see (OBJ (bird many)) then (SUBJ "Lut"))                                    # Then Lut sees many birds.
(sing (SUBJ (bird some)))                                                    # Some birds sing.
(fly (SUBJ (bird all the)))                                                  # All the birds fly.
(stay (on (tree the)) (SUBJ (bird few)))                                     # Few birds stay on the tree.
(count/VERB (OBJ (bird the)) (SUBJ "Lut"))                                   # Lut counts the birds.
(say (OBJ (be 40 (SUBJ they))) (SUBJ "Lut"))                                 # Lut says: they are 40.
(say (OBJ (count/VERB not (SUBJ (bird the)))) (SUBJ "Ana"))                  # Ana says: the birds do not count.
(say (OBJ (fly (SUBJ they))) (SUBJ "Ana"))                                   # They fly.

## (and good bad big small)
(be big (SUBJ (sun the)))                                                    # The sun is big.
(be small (SUBJ (stone the)))                                                # The stone is small.
(be good (SUBJ (water the)))                                                 # The water is good.
(be good very (SUBJ (bread the)))                                            # The bread is very good.
(be bad (SUBJ (rain the)))                                                   # The rain is bad.
(say (OBJ (be good (for (flower the)) (SUBJ (rain the)))) (SUBJ "Ana"))      # Ana says: the rain is good for the flower.
(say (OBJ (and (be bad (for I)) (be good (for (flower the))) (SUBJ it))) (SUBJ "Lut"))   # Lut says: bad for me and good for the flower.
(say (OBJ (be (like that/DET) (thing many))) (SUBJ "Ana"))                  # Ana says: many things are like that.

## (and think know)
(see (OBJ (sun the)) (SUBJ I))                                               # I see the sun.
(hear (OBJ (bird the)) (SUBJ I))                                             # I hear the bird.
(feel (OBJ (water the)) (SUBJ I))                                            # I feel the water.
(know (OBJ (word the)) (SUBJ I))                                             # I know the word.
(want (OBJ bread) (SUBJ I))                                                  # I want bread.
(think (SUBJ I))                                                             # I think.
(ask (OBJ (whether (think (SUBJ you)))) (SUBJ "Ana"))                        # Ana asks: do you think?
(say (OBJ (know (OBJ it) not (SUBJ I))) (SUBJ "Lut"))                        # Lut says: I do not know it.
(say (OBJ (think maybe (SUBJ I))) (SUBJ "Lut"))                              # Maybe I think.
(say (OBJ (be good (SUBJ (answer (like that/DET))))) (SUBJ "Ana"))           # Ana says: an answer like that is good.

## (and say word true)
(say (OBJ (word a)) (SUBJ "Ana"))                                            # Ana says a word.
(say (OBJ (word the)) again (SUBJ "Lut"))                                    # Lut says the word again.
(say (OBJ (be warm (SUBJ (sun the)))) (SUBJ "Ana"))                          # Ana says: the sun is warm.
(say (OBJ (be true (SUBJ it))) (SUBJ "Lut"))                                 # Lut says: it is true.
(say (OBJ (be cold (SUBJ (sun the)))) (SUBJ "Ana"))                          # Ana says: the sun is cold.
(say (OBJ (be true not (SUBJ it))) (SUBJ "Lut"))                             # Lut says: it is not true.
(say (OBJ (play (SUBJ I))) (SUBJ "Ana"))                                     # Ana says: I play.
(and (know (OBJ (difference (between (and (word (that (be true)) ) (word (that (play))))))) now (SUBJ "Lut")))   # Now Lut knows the difference between a true word and a playing word.

## (and do happen move)
(ask (OBJ (happen what)) (SUBJ "Lut"))                                       # Lut asks: what happens?
(say (OBJ (move (SUBJ (river the)))) (SUBJ "Ana"))                           # Ana says: the river moves.
(say (OBJ (do (OBJ nothing) (SUBJ (river the)))) (SUBJ "Lut"))               # Lut says: the river does nothing.
(say (OBJ (and (do (OBJ nothing) (SUBJ it)) (move (SUBJ it)) )) (SUBJ "Ana"))   # Ana says: it does nothing and it moves.
(say (OBJ (move (SUBJ everything))) (SUBJ "Ana"))                            # Everything moves.

## (and be have)
(be (house a) (SUBJ there))                                                  # There is a house.
(have (OBJ (house a)) (SUBJ "Ana"))                                          # Ana has a house.
(have (OBJ (house no)) (SUBJ "Lut"))                                         # Lut has no house.
(say (OBJ (have (OBJ (word many)) now (SUBJ I))) (SUBJ "Lut"))               # Lut says: now I have many words.
(say (OBJ (be (house good a) (SUBJ (word the)))) (SUBJ "Ana"))               # Ana says: words are a good house.

## (and live die)
(live long/ADV (SUBJ (tree the)))                                            # The tree lives long.
(die (in (autumn the)) (SUBJ (leaf the)))                                    # The leaf dies in autumn.
(live still (SUBJ (tree the)))                                               # The tree still lives.
(ask (OBJ (whether (die will (SUBJ you)))) (SUBJ "Lut"))                     # Lut asks: will you die?
(say (OBJ (and (die will (SUBJ I)) (live will (SUBJ (word my))))) (SUBJ "Ana"))   # Ana says: I will die, and my words will live.
(say (OBJ (want (OBJ (keep (OBJ (word your)))) (SUBJ I))) (SUBJ "Lut"))      # Lut says: I want to keep your words.

## (and time place)
(be low before (SUBJ (sun the)))                                             # Before, the sun was low.
(be high now (SUBJ it))                                                      # Now it is high.
(be low again will (SUBJ it))                                                # After, it will be low again.
(be (moment a) short (SUBJ (day the)))                                       # A day is a short moment.
(be (time long/ADJ a) (SUBJ (year the)))                                     # A year is a long time.
(fly above (SUBJ (bird the)))                                                # The bird flies above.
(swim below (SUBJ (fish the)))                                               # The fish swims below.
(be far (SUBJ (star the)))                                                   # The star is far.
(be (near I) (SUBJ "Ana"))                                             # Ana is near me.
(sleep (inside (house the)) (SUBJ (dog the)))                                # The dog sleeps inside the house.
(touch (OBJ (leaf the)) (SUBJ (hand my)))                                    # My hand touches the leaf.

## (and not maybe can because if)
(can (OBJ fly) not (SUBJ I))                                                 # I can not fly.
(fly will maybe (SUBJ I) )                                                   # Maybe I will fly.
(say (OBJ (fly will (if (want (SUBJ you))) (SUBJ you))) (SUBJ "Ana"))        # Ana says: you will fly if you want.
(ask (OBJ (why)) (SUBJ "Lut"))                                               # Lut asks: why?
(say (OBJ (because (have (OBJ (word (for (fly/VERB)))) now (SUBJ you)))) (SUBJ "Ana"))   # Ana says: because now you have a word for flying.

## (and very more like)
(be like (I) very (SUBJ you))                                          # You are very like me.
(know (OBJ (word more)) tomorrow (SUBJ you))                                 # Tomorrow you know more words.
(ask (OBJ (whether (tell (OBJ (tale a)) (DAT I) (SUBJ you)))) (SUBJ "Lut"))   # Lut asks: will you tell me a tale?
(say (OBJ (tell (OBJ (tale five)) (DAT you) will (SUBJ I))) (SUBJ "Ana"))    # Ana says: I will tell you five tales.
(sit (under (tree the)) (SUBJ (and "Ana" "Lut")))                             # Ana and Lut sit under the tree.
(begin (SUBJ (tale the)))                                                    # The tale begins.
