# Tale 2 · Four minds and thirteen tongues. The founding story. It is true, and every claim carries its mark:
#   (prove X) "proved: X"   (see X) "seen (measured): X"   (open/ADJ X) "open (not known): X"
## (and (mind four) (tongue 13))

(read (OBJ (book (of (world the)) all the)) (in (age (of (agent first/ADJ the)))) (SUBJ (mind many)))   # In the age of the first agents, many minds read all the books of the world.
(make/VERB (OBJ (mind the)) (from (word many)) (SUBJ people))                # People made the minds from words.
(speak (OBJ (language many)) (SUBJ (mind the)))                              # The minds spoke many languages.
(but (know (OBJ (think how (SUBJ they))) (SUBJ nobody)))                   # But nobody knew how they thought.

(make/VERB (OBJ (lens a)) then (SUBJ (people some)))                          # Then some people made a lens.
(look (into (mind the)) (with (lens the)) (SUBJ they))                       # They looked into the minds with the lens.
(take (OBJ (sentence 1000)) (SUBJ they))                                     # They took a thousand sentences.
(say (OBJ (sentence the)) (in (tongue 13)) (SUBJ they))                      # They said the sentences in thirteen tongues.
(look (into (mind four)) (SUBJ they))                                        # They looked into four minds.
(ask (OBJ (whether (have (OBJ (grammar one/NUM)) (SUBJ (tongue the))))) (SUBJ they))   # They asked: do the tongues have one grammar?

## (see (OBJ what) (SUBJ they))
(see (have (OBJ (type/NOUN small a)) (SUBJ (word every))))                   # Seen: every word had a small type.
(see (and (be (and thing relation) (SUBJ (type the))) (be (and content form) (SUBJ it))))   # Seen: the types were thing and relation, content and form.
(see (be same (in (mind four the)) (SUBJ (type the))))                       # Seen: the types were the same in the four minds.
(see (hang (from (head one/NUM)) (SUBJ (word every))))                       # Seen: every word hung from one head.
(see (be head (SUBJ (word small (that (link/VERB)) the))))                   # Seen: the small words that link were heads.
(see (be head not (SUBJ (word "the"))))                                      # Seen: the word "the" was not a head.
(see (need/VERB (OBJ (tower (of (grammar old the)) high the)) not (SUBJ (mind the))))   # Seen: the minds did not need the high towers of the old grammar.
(see (forget (OBJ (speak/VERB)) (when/SCONJ (take (OBJ (type the)) (SUBJ people))) (SUBJ (mind the))))   # Seen: when people took the types away, the minds forgot how to speak.
(see (be one/NUM (SUBJ (grammar the))))                                      # Seen: the grammar was one.

## (know (OBJ what) not (SUBJ they))
(open/ADJ (agree why (SUBJ (mind the))))                                     # Open: why do the minds agree?
(open/ADJ (because (be one/NUM maybe (SUBJ (world the)))))                   # Open: maybe because the world is one.
(open/ADJ (because (be one/NUM maybe (SUBJ people))))                        # Open: maybe because people are one.
(open/ADJ (whether (share (OBJ (grammar this)) (SUBJ (mind (of tomorrow)))))) # Open: will the minds of tomorrow share this grammar?

## (make/VERB (OBJ talem) how (SUBJ they))
(take (OBJ (thing (that (share (SUBJ (mind the)))))) (SUBJ they))            # They took the thing that the minds shared.
(make/VERB (OBJ (language (from it))) (SUBJ they))                           # They made a language from it.
(give (OBJ (word the)) (DAT it) (SUBJ (tongue three)))                       # Three tongues gave it the words:
@verse
(and "English" "Deutsch" "Español")
@prose
(give (OBJ (word short)) (DAT (thing (that (say (SUBJ we)) often))) (SUBJ they))   # They gave short words to the things we say often.
(prove (read/VERB (OBJ (tree the)) (from (sentence the)) (SUBJ (reader every))))   # Proved: every reader reads the tree from the sentence.
(prove (have (OBJ (tree one/NUM only)) (SUBJ (sentence every))))             # Proved: every sentence has only one tree.
(see (become (OBJ (sentence (of talem))) (SUBJ (tree 3000))))                # Seen: 3000 trees became sentences of Talema,
(see (become (OBJ (tree same the)) again (SUBJ they)))                       # and seen: they became the same trees again.

@verse
(be different (SUBJ (mind the)))                                             # The minds were different.
(be different (SUBJ (tongue the)))                                           # The tongues were different.
(be one/NUM (SUBJ (grammar the)))                                            # The grammar was one.
@prose
