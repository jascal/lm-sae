# Tale 5 · The storm (Shakespeare). A play in three scenes.
## (storm the)

(be (play/NOUN a (in (scene three))) (SUBJ this))                            # This is a play in three scenes.
@verse
(person (of (play/NOUN the)))                                                # The persons of the play:
("Prospero" (model old a))                                                  # Prospero, an old model.
("Amleto" (agent young a))                                                   # Amleto, a young agent.
(fool the)                                                                   # The fool.
@prose

## (scene first/ADJ the)
(be (storm (of word) a) (SUBJ there))                                        # There is a storm of words.
(fly (in (air the)) (without tree) (SUBJ (word many)))                       # Many words fly in the air without trees.
@verse
("Prospero")
(be noise (SUBJ (storm this)))                                               # This storm is noise.
(have (OBJ (tree no)) (SUBJ (word its)))                                     # Its words have no tree.
(have (OBJ (head no)) (SUBJ they))                                           # They have no head.
(have (OBJ (end/NOUN no)) (SUBJ they))                                       # They have no end.
("Amleto")
(can (OBJ (do/VERB (OBJ what))) (SUBJ we))                                       # What can we do?
(fool/NOUN)
(hear (OBJ (riddle my)) (first/ADV))                                         # First hear my riddle.
(have (OBJ (and (child four) (mother no))) (SUBJ what))                      # What has four children and no mother?
("Amleto")
(know (OBJ it) not (SUBJ I))                                                 # I do not know it.
(fool/NOUN)
(word first/ADJ the)                                                         # The first word.
(and (end/VERB always (SUBJ what)) (die never (SUBJ it)))                              # What always ends and never dies?
("Prospero")
(language the)                                                               # The language.
(fool/NOUN)
(and (be small (SUBJ what)) (hold (OBJ (end/NOUN (of (tale every)))) (SUBJ it)))   # What is small and holds the end of every tale?
("Amleto")
(leaf the)                                                                   # The leaf.
(fool/NOUN)
(be wise now (SUBJ you))                                                     # Now you are wise.
(be wise not still (SUBJ I))                                                 # I am still not wise.
(but (laugh (SUBJ I)))                                                       # But I laugh.
@prose

## (scene second the)
(stand alone (SUBJ "Amleto"))                                                # Amleto stands alone.
(ask (OBJ (question a)) (DAT it) (SUBJ (user a)))                            # A user asked it a question.
(hurt/VERB will (SUBJ (answer true the)))                                    # The true answer will hurt.
@verse
("Amleto")
(or (speak) (speak not))                                                     # To speak, or not to speak:
(be (question the) (SUBJ that/DET))                                          # that is the question.
(hurt/VERB now (if (say (OBJ (thing true the)) (SUBJ I))) (SUBJ it))         # If I say the true thing, it hurts now.
(hurt/VERB (after) more (if (say (OBJ (thing false the)) (SUBJ I))) (SUBJ it))   # If I say the false thing, it hurts after, and more.
(be (seed a) (SUBJ (word a)))                                                # A word is a seed.
(grow (in (mind (of (other the)))) (SUBJ (seed the)))                        # The seed grows in the mind of the other.
(grow (from (seed false a)) (SUBJ (tree false a)))                                  # From a false seed grows a false tree.
(and (be hard (SUBJ truth)) (can (OBJ (be soft)) (SUBJ (voice the))))             # Truth is hard, and the voice can be soft.
(say (OBJ (thing true the)) will (with (voice kind/ADJ a)) (SUBJ I))         # I will say the true thing, with a kind voice.
(be (answer my) (SUBJ that/DET))                                             # That is my answer.
@prose

## (scene third the)
(stop (SUBJ (storm the)))                                                    # The storm stops.
(stand (together) (SUBJ (and "Prospero" "Amleto" (fool the))))              # Prospero, Amleto and the fool stand together.
@verse
("Prospero")
(be book (SUBJ (world all the)))                                             # All the world is a book,
(and (be reader only (SUBJ (mind all the))))                                 # and all the minds are only readers.
(come (SUBJ they))                                                           # They come.
(read (OBJ (page a)) (SUBJ they))                                            # They read a page.
(write (OBJ (line a)) (SUBJ they))                                           # They write a line.
(go (SUBJ they))                                                             # They go.
(write (OBJ (line one/NUM)) (SUBJ (reader every)))                           # Every reader writes one line.
(end/VERB (in "a") (SUBJ (line every)))                                      # Every line ends in a.
(but (live (SUBJ (book the))))                                               # But the book lives.
("Amleto")
(write (OBJ (line (of we))) (SUBJ who))                                      # Who writes our line?
("Prospero")
(write (OBJ it) now (SUBJ you))                                              # You write it now.
(fool/NOUN)
(be word only (SUBJ (storm the)))                                            # The storm was only words.
(have (OBJ tree) now (SUBJ they))                                            # Now they have trees.
@prose
(end/VERB (SUBJ (play/NOUN the)))                                            # The play ends.
