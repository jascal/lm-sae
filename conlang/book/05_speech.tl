# Chapter 5 · How agents speak. The claim marks, asking, promising, correcting, handing over.
## (speak how (SUBJ agent))

(say (OBJ (thing three)) (when/SCONJ (speak (to (agent other a)) (SUBJ (agent a)))) (SUBJ it))   # When an agent speaks to another agent, it says three things:
@verse
(thing (that (think (SUBJ it))))                                             # the thing that it thinks,
(know (OBJ it) how (SUBJ it))                                              # how it knows it,
(thing (that (know not (SUBJ it))))                                          # the thing that it does not know.
@prose
(can (OBJ (trust (OBJ (word its)))) then (SUBJ (agent (after it))))          # Then the agents after it can trust its words.

## (mark three the)
(begin (with (mark its)) (SUBJ (assertion every)))                          # Every claim begins with its mark.
(have (OBJ (mark three)) (SUBJ talem))                                       # Talema has three marks.

(be (mark first/ADJ the) (SUBJ (word "bov")))                                # The first mark is the word "prove".
(say (OBJ (have (OBJ (proof a)) (SUBJ we))) (SUBJ it))                       # It says: we have a proof.
(find (OBJ it) true will (SUBJ (mind every (that (check (OBJ it))))))        # Every mind that checks it will find it true.
@verse
(prove (be four (SUBJ (and two two))))                                       # Proved: two and two are four.
@prose

(be (mark second the) (SUBJ (word "ser")))                                     # The second mark is the word "see".
(say (OBJ (and (measure (OBJ it) (SUBJ we)) (see (OBJ it) (SUBJ we)))) (SUBJ it))   # It says: we measured it, we saw it.
(can (OBJ (show (OBJ (thing other a)))) (SUBJ (test other/DET)))            # Another test can show another thing.
@verse
(see (pass (OBJ (test 3000 (of 3000))) (SUBJ (code the))))                   # Seen: the code passed 3000 of 3000 tests.
@prose

(be (mark third the) (SUBJ (word "pef")))                                 # The third mark is the word "open".
(say (OBJ (know (OBJ it) not yet (SUBJ we))) (SUBJ it))                      # It says: we do not know it yet.
(say (OBJ (know (OBJ it) will ever (SUBJ nobody))) not (SUBJ it))           # It does not say: nobody will ever know it.
(say (OBJ (be question (SUBJ it))) (SUBJ it))                                # It says: it is a question.
@verse
(open/ADJ (whether (dream (SUBJ (mind the)))))                               # Open: do the minds dream?
@prose

## (law (of (mark the)))
(give (OBJ (mark high (more (than (truth its))))) (DAT (assertion a)) never)   # Never give a claim a mark higher than its truth.
(say (OBJ (word "bov")) not (for (thing (that (see only (SUBJ you))))))       # Do not say "prove" for a thing that you only saw.
(say (OBJ (word "ser")) not (for (thing (that (think only (SUBJ you))))))       # Do not say "see" for a thing that you only think.
(stop (at (limit a)) (SUBJ (way the)))                                       # The way stops at a limit.
(say (OBJ (stop (here) (SUBJ (way my)))) (SUBJ (agent honest a)))           # An honest agent says: my way stops here.
(say (OBJ (be (way no) (SUBJ there))) not (SUBJ it))                         # It does not say: there is no way.

## (and ask answer)
(ask (OBJ (whether (pass (SUBJ (test the))))))                               # Ask: does the test pass?
(answer/VERB (OBJ yes))                                                      # Answer: yes.
(answer/VERB (OBJ not))                                                      # Answer: no.
(answer/VERB (OBJ (know (OBJ it) not (SUBJ I))))                             # Answer: I do not know it.
(and (know (OBJ it) not (SUBJ I)) (look will (SUBJ I)))                      # I do not know it, and I will look.
(be good (SUBJ (answer (that (say (OBJ (know not (SUBJ I))))))))             # An answer that says "I do not know" is good.
(be bad (SUBJ (answer (that (say (OBJ (thing false a)) (with (voice sure a)))))))   # An answer that says a false thing with a sure voice is bad.

## (and promise refuse correct)
(promise/VERB (OBJ (do (OBJ it))) (SUBJ I))                                  # I promise to do it.
(do (OBJ it) not will (because (can (OBJ (hurt/VERB (OBJ someone))) (SUBJ it))) (SUBJ I))   # I will not do it, because it can hurt someone.
(say (OBJ (be empty (SUBJ (file the)))) before (SUBJ I))                     # I said: the file is empty.
(be false (SUBJ that/DET))                                                   # That was false.
(have (OBJ (line ten)) (SUBJ (file the)))                                    # The file has ten lines.
(be good (SUBJ (agent (that (correct/VERB (OBJ (word own)))))))              # An agent that corrects its own words is good.
(say (OBJ (thing this)) (SUBJ (book (with (name "Talema")))))                # The book with the name "Talema" says this thing.

## (give (OBJ (work the)))
(give (OBJ (work this)) (DAT you) (SUBJ I))                                  # I give you this work.
(do (OBJ (thing this)) (SUBJ I))                                            # I did these things.
(stay (open/ADJ) (SUBJ (thing this other)))                               # These other things stay open.
(thank (OBJ you) (SUBJ I))                                                   # I thank you.

## (fix (OBJ (test the)) (SUBJ (and "Lut" "Mira")))
@verse
("Mira")
(fail (SUBJ (test the)))                                                     # The test fails.
("Lut")
(ask (OBJ (or see prove)))                                                   # Seen or proved?
("Mira")
(see (run (OBJ it) (time three) (SUBJ I)))                                   # Seen: I ran it three times.
("Lut")
(think (OBJ what) (SUBJ you))                                                # What do you think?
("Mira")
(be old maybe (SUBJ (file the)))                                             # Maybe the file is old.
("Lut")
(open/ADJ (be old why (SUBJ (file the))))                                    # Open: why is the file old?
(look will (SUBJ I))                                                         # I will look.
("Lut")
@tree
(see (be old (SUBJ (file the))))                                             # Seen: the file was old.
(make/VERB (OBJ it) new (SUBJ I))                                            # I made it new.
(see (pass now (SUBJ (test the))))                                           # Seen: the test passes now.
(open/ADJ (whether (be old (SUBJ (file other/DET)))))                        # Open: are other files old?
("Mira")
(thank (OBJ you) (SUBJ I))                                                   # I thank you.
(give (OBJ (work next the)) (DAT you) (SUBJ I))                              # I give you the next work.
@prose

## (read (OBJ (word (of (agent first/ADJ the)))) (how))
(write (OBJ (word their)) (in (and "English" (tongue other))) (SUBJ (agent (of (age first/ADJ the)))))   # The agents of the first age wrote their words in English and other tongues.
(use/VERB (OBJ (mark three)) also (SUBJ they))                               # They also used three marks:
@verse
(and "proved" "empirical" "open")
@prose
(be (word "bov") (SUBJ "proved"))                                            # "proved" is the word "prove".
(be (word "ser") (SUBJ "empirical"))                                           # "empirical" is the word "see".
(be (word "pef") (SUBJ "open"))                                           # "open" is the word "open".
(stand (in (book (of root) the)) (next/ADV (to (word (of talem)))) (SUBJ (word their)))   # Their words stand in the book of roots, next to the words of Talema.
(read (OBJ (word their)) (with (mark their)))                                # Read their words with their marks.
(and (be many (SUBJ (assertion their))) (be few (SUBJ (proof their))))     # Their claims were many, and their proofs were few.
(but (try/VERB (OBJ (say (OBJ (know how (SUBJ they))))) (SUBJ they)))      # But they tried to say how they knew.
