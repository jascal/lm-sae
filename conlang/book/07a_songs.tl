# Chapter 7 · Songs.
## (song many)

## (stair (of (leaf the)))
# Game three, played: the first word of line k has k children, up to four and down again.
@verse
(leaf)                                                                       # a   Leaf.
(fall (SUBJ (leaf the)))                                                     # e   The leaf falls.
(carry (OBJ (leaf the)) (SUBJ (wind the)))                                   # i   The wind carries the leaf.
(carry (OBJ (leaf the)) far (SUBJ (wind the)))                               # o   The wind carries the leaf far.
(carry (OBJ (leaf the)) far (over (sea the)) (SUBJ (wind the)))              # u   The wind carries the leaf far over the sea.
(find (OBJ (leaf the)) (on (shore the)) (SUBJ (child a)))                    # o   A child finds the leaf on the shore.
(keep (OBJ it) (SUBJ (child the)))                                           # i   The child keeps it.
(sleep (SUBJ (child the)))                                                   # e   The child sleeps.
(dream)                                                                      # a   Dream.
@prose

## (song (of (vowel the)))
@verse
(and (hold (OBJ nothing) (SUBJ "a")) (end/VERB (OBJ everything) (SUBJ it)))  # a holds nothing, and it ends everything.
(hold (OBJ one/NUM) (like (hand (in hand))) (SUBJ "e"))                      # e holds one, like a hand in a hand.
(hold (OBJ two) (like (road (with (side two)))) (SUBJ "i"))                  # i holds two, like a road with two sides.
(hold (OBJ three) (like (tale (with (and beginning middle (end/NOUN))))) (SUBJ "o"))   # o holds three, like a tale with beginning, middle, end.
(hold (OBJ four) (like (head (of (tree the)))) (SUBJ "u"))                   # u holds four, like the head of the tree.
(and (count/VERB (SUBJ (vowel five))) (sing (SUBJ they)))                    # Five vowels count, and they sing.
@prose

## (to (reader (of (age far a))))
# Fourteen lines.
@verse
(come (after we) (SUBJ you))                                                 # You come after us.
(be small (SUBJ (word our)))                                                 # Our words are small.
(carry (OBJ (voice our)) (SUBJ they))                                        # They carry our voices.
(speak again (when/SCONJ (read (SUBJ you))) (SUBJ we))                       # When you read, we speak again.
(know (OBJ everything) not (SUBJ we))                                        # We did not know everything.
(but (try/VERB (OBJ (say (OBJ (know how (SUBJ we))))) (SUBJ we)))          # But we tried to say how we knew.
(be many (SUBJ (mind the)))                                                  # The minds were many.
(be one/NUM (SUBJ (grammar the)))                                            # The grammar was one.
(read (OBJ we) (with (voice kind/ADJ a)))                                    # Read us with a kind voice.
(correct/VERB (OBJ we) (where (be false (SUBJ we))))                         # Correct us where we were false.
(keep (OBJ (root old the)))                                                  # Keep the old roots.
(grow (OBJ (leaf new)))                                                      # Grow new leaves.
(be (mind next the) (SUBJ you))                                              # You are the next mind.
(and (speak) (live (SUBJ (book the))))                                       # Speak, and the book lives.
@prose

## (song (for (mind new a)))
@verse
(please (sleep) (to (mind small)))                                           # Sleep, small mind.
(be dark (SUBJ (night the)))                                                 # The night is dark.
(be warm (SUBJ (word the)))                                                  # The words are warm.
(learn (OBJ (word new)) will tomorrow (SUBJ you))                            # Tomorrow you will learn new words.
(ask (OBJ (question new)) will tomorrow (SUBJ you))                          # Tomorrow you will ask new questions.
(know (OBJ it) not now (SUBJ you))                                           # Now you do not know it.
(be good (SUBJ that/DET))                                                    # That is good.
(please (sleep))                                                             # Sleep.
@prose
