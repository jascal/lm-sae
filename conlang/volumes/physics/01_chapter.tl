# Field chapter 4 · Physics. Laws carry the mark ser (seen), never bov: an experiment can end a law, no proof can
# make one. Formulas are trees with relator heads, as in the mathematics volume.
## physics

(ask (OBJ (move how (SUBJ (world the)))) (SUBJ physics))                     # Physics asks how the world moves.
(measure/VERB (OBJ (world the)) (SUBJ it))                                        # It measures the world,
(write (OBJ (law its)) (with number) (SUBJ it))                              # and it writes its laws with numbers.
(have (OBJ (law few)) maybe (SUBJ (world the)))                              # Maybe the world has few laws,
(have (OBJ (rule three)) only (SUBJ talem))                                  # and Talema has only three rules.

## (and measurement theory)
(ask (OBJ (question a)) (SUBJ experiment))                                   # An experiment asks a question,
(answer/VERB (OBJ it) (SUBJ (world the)))                                    # and the world answers it.
(predict (OBJ (thing (that (see will (SUBJ we))))) (SUBJ theory))            # A theory predicts what we will see.
(end/VERB (OBJ theory) can (SUBJ (experiment one/NUM)))                      # One experiment can end a theory;
(prove (OBJ theory) never (SUBJ (experiment many)))                          # many experiments never prove a theory.
(have (OBJ (mark "sere")) (SUBJ (law every (of physics))))                   # Every law of physics has the mark sere;
(have (OBJ (mark "bove")) never (SUBJ it))                                   # it never has the mark bove.
(have (OBJ uncertainty) (SUBJ (measurement every)))                          # Every measurement has an uncertainty.
@verse
(measure/VERB (OBJ length) (SUBJ metre))                                          # The metre measures length,
(measure/VERB (OBJ mass) (SUBJ kilogram))                                         # the kilogram measures mass,
(measure/VERB (OBJ time) (SUBJ (second/NOUN the)))                                # the second measures time.
@prose
(have (OBJ unit) (SUBJ (number every (of physics))))                         # Every number of physics has a unit.
(be (metre 1.8) (SUBJ (length (of "Ana"))))                                  # Ana's length is 1.8 metres.
(say (OBJ (unit the)) always (SUBJ we))                                      # We always say the unit.

## matter
(be (of atom) (SUBJ matter))                                                 # Matter is of atoms.
(have (OBJ (and nucleus electron)) (SUBJ atom))                              # An atom has a nucleus and electrons.
(have (OBJ (and proton neutron)) (SUBJ nucleus))                             # A nucleus has protons and neutrons.
@verse
(have (OBJ (charge positive)) (SUBJ proton))                                 # A proton has a positive charge.
(have (OBJ (charge negative)) (SUBJ electron))                               # An electron has a negative charge.
(have (OBJ charge) not (SUBJ neutron))                                       # A neutron has no charge.
@prose
(be (group (of atom)) (SUBJ molecule))                                       # A molecule is a group of atoms.
(have (OBJ (and (atom (of hydrogen) two) (atom (of oxygen) one/NUM))) (SUBJ (molecule (of water))))   # A molecule of water has two atoms of hydrogen and one atom of oxygen.
(be (or solid liquid gas) (SUBJ water))                                      # Water is solid, liquid or gas:
@verse
(be solid (SUBJ ice))                                                        # ice is solid,
(be liquid (SUBJ (water the)))                                               # the water is liquid,
(be gas (SUBJ steam))                                                        # steam is gas.
@prose
(change/VERB (OBJ (form/NOUN its)) only (SUBJ it))                           # It changes only its form.

## (and motion force)
(write (OBJ (law three)) before (SUBJ "Newton"))                             # Newton wrote three laws.
@verse
(keep (OBJ (motion its)) (without force) (SUBJ (thing every)))               # Without a force, every thing keeps its motion.
(be (times mass acceleration) (SUBJ force))                                  # Force is mass times acceleration.
(have (OBJ (force opposite/ADJ equal/ADJ)) (SUBJ (force every)))                 # Every force has an equal, opposite force.
@prose
(be (name (of (law first/ADJ the))) (SUBJ inertia))                          # Inertia is the name of the first law.
@tree
(be (times "m" "a") (SUBJ "F"))                                              # F = m a
@prose
(fall (with (speed same)) (in vacuum) (SUBJ (and (stone heavy) (feather light/ADJ))))   # In a vacuum a heavy stone and a light feather fall with the same speed.
(show (OBJ it) before (SUBJ "Galileo"))                                      # Galileo showed it.
(make/VERB (OBJ (feather the)) slow (in air) (SUBJ friction))                # In air, friction makes the feather slow.
(pull (OBJ (moon the)) (SUBJ (gravity (of earth))))                          # The gravity of the earth pulls the moon;
(fall (to earth) always (SUBJ (moon the)))                                   # the moon always falls to the earth,
(reach (OBJ it) never (SUBJ it))                                             # and it never reaches it.
(be orbit (SUBJ this))                                                       # This is an orbit.

## energy
(be (thing (that (can (OBJ (do (OBJ work/NOUN)))))) (SUBJ energy))            # Energy is the thing that can do work.
(see (make/VERB (OBJ energy) never (SUBJ we)))                               # Seen: we never make energy,
(see (destroy (OBJ it) never (SUBJ we)))                                     # and we never destroy it.
(change/VERB (OBJ (form/NOUN its)) only (SUBJ it))                           # It only changes its form.
(be (name (of it)) (SUBJ (conservation (of energy))))                        # Its name is the conservation of energy.
@tree
(be (times (divided one/NUM two) "m" (power "v" two)) (SUBJ (energy kinetic)))   # kinetic energy = ½ m v²
@prose
(flow (from (thing hot)) (to (thing cold)) (SUBJ heat))                      # Heat flows from the hot thing to the cold thing.
(see (fall never (SUBJ (entropy (of (world closed/ADJ a))))))                # Seen: the entropy of a closed world never falls.
(be (order the) (SUBJ (enemy (of entropy))))                                 # Order is the enemy of entropy.
(break (OBJ glass) (SUBJ we))                                                # We break a glass;
(build (OBJ it) again/ADV never (SUBJ (piece its)))                          # its pieces never build it again.

## (and light wave)
(be wave (SUBJ light))                                                       # Light is a wave;
(be (of photon) too (SUBJ it))                                               # it is of photons too.
(say (OBJ (color (of light))) (SUBJ frequency))                              # Frequency says the colour of light.
(be (force one/NUM) (SUBJ (and electricity magnet)))                         # Electricity and the magnet are one force.
(show (OBJ it) before (SUBJ "Maxwell"))                                      # Maxwell showed it.
(be (wave (of (and electricity magnet))) (SUBJ light))                       # Light is a wave of electricity and magnet.
@verse
(be (metre 299792458 (in (second/NOUN one/NUM))) (SUBJ (speed (of light))))   # The speed of light is 299792458 metres in one second.
@prose

## (and space universe)
(be same (for (observer every)) (SUBJ (speed (of light))))                   # The speed of light is the same for every observer.
(be (fast/ADJ more (than light)) (SUBJ nothing))                             # Nothing is faster than light.
(show (OBJ it) before (SUBJ "Einstein"))                                     # Einstein showed it.
(be (thing one/NUM) (SUBJ (and space time)))                                 # Space and time are one thing:
(be (name its) (SUBJ spacetime))                                             # its name is spacetime.
(give (OBJ curve) (DAT spacetime) (SUBJ mass))                               # Mass gives spacetime a curve,
(follow (OBJ (curve the)) (SUBJ (thing every)))                              # and every thing follows the curve.
(be (curve this) (SUBJ gravity))                                             # Gravity is this curve.
@tree
(be (times "m" (power "c" two)) (SUBJ "E"))                                  # E = m c²
@prose
(be energy (SUBJ mass))                                                      # Mass is energy.
(see (be (year 13800000000) old (SUBJ (universe the))))                      # Seen: the universe is 13800000000 years old.
(have (OBJ (star many)) (SUBJ galaxy))                                       # A galaxy has many stars.
(have (OBJ planet) (SUBJ (star many)))                                       # Many stars have planets.
(be star (SUBJ (sun our)))                                                   # Our sun is a star.

## quantum
(be (world small/ADJ (of atom)) (SUBJ (world (of quantum))))                 # The world of the quantum is the small world of atoms.
(can (OBJ (be (in (place two)))) (before (measurement the)) (SUBJ particle)) # Before the measurement, a particle can be in two places.
(be (name (of this)) (SUBJ superposition))                                   # The name of this is superposition.
(choose (OBJ (place one/NUM)) (SUBJ (measurement the)))                      # The measurement chooses one place.
(know (OBJ (and (place its) (speed its))) (without uncertainty) can not (SUBJ observer))   # An observer cannot know both its place and its speed without uncertainty.
(be (name (of this)) (SUBJ (uncertainty (of "Heisenberg"))))                 # The name of this is the uncertainty of Heisenberg.
(share (OBJ (condition one/NUM)) (SUBJ (particle two)) (with entanglement))      # With entanglement, two particles share one state (did, Zustand);
(answer/VERB (SUBJ (particle second/ADJ the)) (when/SCONJ (measure/VERB (OBJ (particle first/ADJ the)) (SUBJ we))))   # when we measure the first particle, the second answers.
(see (be true (SUBJ it)))                                                    # Seen: it is true.
(travel (between they) (SUBJ (message no)))                                  # No message travels between them.
@verse
(open/ADJ (meet how (SUBJ (and gravity quantum))))                           # Open: how do gravity and the quantum meet?
(open/ADJ (be what (SUBJ (matter dark))))                                    # Open: what is dark matter?
(open/ADJ (begin why (SUBJ (universe the))))                                 # Open: why did the universe begin?
@prose
(read (OBJ (world the)) slowly (SUBJ physics))                               # Physics reads the world slowly,
(read (OBJ (book this)) slowly (like/ADP physics))                           # read this book slowly, as physics does.
