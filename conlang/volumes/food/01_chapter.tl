# Field chapter 7 · Food and eating. The words of the table and the kitchen, which the frequency-built lexicon
# lacked in part (sandwich, fork, spoon, banana …). Meals, tastes, the table, a recipe, a restaurant.
## food

(eat (SUBJ (person every)))                                                  # Every person eats.
(eat (OBJ food) (when/SCONJ (be hungry (SUBJ we))) (SUBJ we))                # When we are hungry, we eat food.
(drink (OBJ water) (when/SCONJ (be thirsty (SUBJ we))) (SUBJ we))            # When we are thirsty, we drink water.
(eat (OBJ (meal three)) (in (day a)) (SUBJ (people many)))                   # Many people eat three meals in a day:
@verse
(breakfast (in (morning the)))                                               # breakfast in the morning,
(lunch (in (middle/NOUN (of (day the)))))                                    # lunch in the middle of the day,
(dinner (in (evening the)))                                                  # dinner in the evening.
@prose
(eat (OBJ snack) (between (meal two)) (SUBJ some))                           # Some eat a snack between two meals.
(come (after dinner) (SUBJ dessert))                                         # Dessert comes after dinner.

## (and sweet salty sour bitter)
(have (OBJ (taste/NOUN four)) (SUBJ tongue))                                 # The tongue has four tastes.
@verse
(be sweet (SUBJ sugar))                                                      # Sugar is sweet.
(be salty (SUBJ salt))                                                       # Salt is salty.
(be sour (SUBJ lemon))                                                       # A lemon is sour.
(be bitter (SUBJ coffee))                                                    # Coffee is bitter.
@prose
(be (word three) (SUBJ (and (word "salat") (word "salad") (word "salut"))))  # salat, salad and salut are three words:
(be salt (SUBJ "salat"))                                                     # salat is salt,
(be salad (SUBJ "salad"))                                                    # salad is a salad,
(be salty (SUBJ "salut"))                                                    # and salut is salty.
(read (OBJ they) slowly)                                                     # Read them slowly.

## bread
(eat (OBJ bread) (in (land every)) (SUBJ people))                            # People eat bread in every land.
(tell (OBJ (tale a)) (SUBJ people))                                          # People tell a tale.
@verse
(play (OBJ card) (for (hour many)) (SUBJ (man a)))                           # A man plays cards for many hours.
(want (OBJ (leave (OBJ (table the)))) not (SUBJ he))                         # He does not want to leave the table.
(ask (for (meat (between (bread (of (piece two)))))) (SUBJ he))              # He asks for meat between two pieces of bread.
(be "Sandwich" (SUBJ (name his)))                                            # His name is Sandwich.
@prose
(be (name (of (food this))) (SUBJ sandwich))                                 # Sandwich is the name of this food.
(be tale (SUBJ this) maybe)                                                  # Maybe this is a tale.
(be good (SUBJ sandwich) (with (and cheese tomato)))                         # A sandwich is good with cheese and tomato.

## (and fruit vegetable)
@verse
(be sweet (SUBJ (and apple pear peach cherry strawberry)))                   # Apples, pears, peaches, cherries and strawberries are sweet.
(be yellow (SUBJ banana))                                                    # A banana is yellow.
(be orange/NOUN (SUBJ (fruit (of (tree orange/NOUN the)))))                  # The fruit of the orange tree is an orange.
@prose
(grow (in (earth the)) (SUBJ (and potato carrot onion garlic)))              # Potatoes, carrots, onions and garlic grow in the earth.
(make/VERB (OBJ salad) (from (and tomato cucumber)) (SUBJ we))               # We make a salad from tomatoes and cucumbers.
(eat (OBJ (vegetable many)) (for (health good)))                             # Eat many vegetables, for good health.

## table
(set/VERB (OBJ (table the)) (SUBJ we))                                       # We set the table.
@verse
(eat (OBJ soup) (with spoon) (SUBJ we))                                      # We eat soup with a spoon,
(eat (OBJ meat) (with (and fork knife)) (SUBJ we))                           # meat with a fork and a knife,
(eat (OBJ noodle) (with (stick two)) (in (land some)) (SUBJ we))             # noodles with two sticks in some lands,
(eat (OBJ bread) (with (hand our)) (SUBJ we))                                # bread with our hands.
(drink (OBJ water) (from glass) (SUBJ we))                                   # We drink water from a glass,
(drink (OBJ tea) (from cup) (SUBJ we))                                       # tea from a cup.
@prose
(put (OBJ (food the)) (on plate))                                            # Put the food on a plate,
(put (OBJ soup) (in bowl))                                                   # the soup in a bowl,
(put (OBJ napkin) (on (knee your)))                                          # and a napkin on your knees.

## kitchen
(be (list (of step)) (SUBJ recipe))                                          # A recipe is a list of steps:
(be (like/ADP program) (SUBJ it))                                            # it is like a program.
@tree
(boil (OBJ water) (in (pot/NOUN a)))                                         # Boil water in a pot.
@verse
(put (OBJ egg) (in (water hot the)))                                         # Put an egg in the hot water.
(wait (for (minute seven)))                                                  # Wait for seven minutes.
(eat (OBJ (egg the)))                                                        # Eat the egg.
@prose
(fry (OBJ egg) (in pan) (with oil) (SUBJ we))                                # We fry an egg in a pan with oil.
(bake (OBJ (and bread cake)) (in oven) (SUBJ we))                            # We bake bread and cake in an oven.
(roast (OBJ chicken) (SUBJ we))                                              # We roast a chicken.
(cut (OBJ onion) (with knife) slowly)                                        # Cut the onion slowly with a knife.

## restaurant
(cook (OBJ food) (for guest) (in restaurant) (SUBJ (person a)))              # In a restaurant a person cooks food for guests.
(bring (OBJ food) (to (table the)) (SUBJ waiter))                            # The waiter brings the food to the table.
@verse
(ask (OBJ (want what (SUBJ you))) (SUBJ waiter))                             # The waiter asks: what do you want?
(say (OBJ (please (and sandwich coffee))) (SUBJ "Ana"))                      # Ana says: a sandwich and a coffee, please.
(ask (OBJ (please (bill the))) (after (meal the)) (SUBJ she))                # After the meal she asks: the bill, please.
(say (OBJ (thanks (for (meal good the)))) (SUBJ she))                        # She says: thanks for the good meal.
@prose

## (eat together)
(share (OBJ bread) (with friend) (SUBJ we))                                  # We share bread with friends.
(be (more (than food)) (SUBJ meal))                                          # A meal is more than food:
(eat together (SUBJ we))                                                     # we eat together,
(talk (SUBJ we))                                                             # we talk,
(laugh (SUBJ we))                                                            # we laugh.
(say (OBJ (be good (SUBJ (meal the)))) (SUBJ (table empty)))                 # An empty table says: the meal was good.
