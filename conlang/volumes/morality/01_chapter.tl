# Field chapter 6 · Morality. Three schools (virtue, duty, consequences), the rule many traditions share, tales
# (the ring of Gyges, the veil), the hard cases marked pef, and what the claim marks ask of an agent.
## morality

(must (OBJ (do what)) (SUBJ we))                                             # What must we do?
(ask (OBJ (question this)) (SUBJ morality))                                  # Morality asks this question.
(be old (SUBJ it))                                                           # It is old,
(be new (in (day every)) (SUBJ it))                                          # and it is new every day.
(ask (OBJ it) (SUBJ (child every)))                                          # Every child asks it.
(ask (OBJ it) too (SUBJ (agent every)))                                      # Every agent asks it too.
(say (OBJ (thought (of people many))) (in talem) (SUBJ (book this)))        # This book says the thoughts of many people in Talema.
(be (word our) (SUBJ (word the)))                                            # The words are our words;
(be (thought their) (SUBJ (thought the)))                                    # the thoughts are theirs.
(read (OBJ (book own their)) (for (word own their)))                         # For their own words, read their own books.

## (rule old the)
(say (OBJ (rule one/NUM)) (SUBJ (tradition many)))                           # Many traditions say one rule.
@verse
(do (OBJ (thing (that (want (OBJ it) not (SUBJ you))))) (to (other)) not)    # Do not do to others the thing that you do not want.
(say (OBJ this) before (SUBJ "Confucius"))                                   # Confucius said this.
(do (OBJ (thing (that (want (OBJ it) (SUBJ you))))) (to (other)))            # Do to others the thing that you want.
(say (OBJ this) (SUBJ (teacher many)) then)                                 # Then many teachers said this.
@prose
(be simple (SUBJ (rule the)))                                                # The rule is simple.
(be simple not (SUBJ (use/NOUN its)))                                             # Its use is not simple.

## (school three)
(see (OBJ (part a (of (good the)))) (SUBJ (school every)))                   # Every school sees a part of the good.

@tree
(ask (OBJ (be what (SUBJ (person good a)))) (SUBJ virtue))                   # Virtue asks: what is a good person?
@prose
(be (between (and fear rashness)) (SUBJ courage))                            # Courage is between fear and rashness.
(stand (in (middle/NOUN the)) (SUBJ virtue))                                      # Virtue stands in the middle.
(grow (with practice) (SUBJ it))                                             # It grows with practice:
(become brave (when/SCONJ (act/VERB (with courage) (SUBJ we))) (SUBJ we))               # we become brave when we act bravely.
(say (OBJ this) (SUBJ "Aristotle"))                                          # Aristotle said this.

@tree
(ask (OBJ (be what (SUBJ (rule good a)))) (SUBJ duty))                       # Duty asks: what is a good rule?
@prose
(act/VERB (by rule (that (can (OBJ (want (OBJ it) (for (person every)))) (SUBJ you)))) only)   # Act only by a rule that you can want for every person.
(treat (OBJ (person every)) (as purpose) always)                             # Always treat every person as a purpose,
(treat (OBJ (person every)) (as (tool only)) never)                          # never as only a tool.
(say (OBJ this) (SUBJ "Kant"))                                               # Kant said this.

@tree
(ask (OBJ (be what (SUBJ (consequence good a)))) (SUBJ (school third the)))   # The third school asks: what is a good consequence?
@prose
(make/VERB (OBJ (happiness most the)) (for (person all/DET)) (SUBJ (act/NOUN good the)))   # The good act makes the most happiness for all.
(count/VERB (SUBJ (pain (of (being every)))))                                # The pain of every being counts.
(ask (OBJ (whether (can (OBJ (suffer)) (SUBJ they)))) (SUBJ "Bentham"))      # Bentham asked: can they suffer?
(say (OBJ this) (about (animal the)) (SUBJ he))                              # He said this about the animals.

## (and promise/NOUN trust/NOUN)
(give (OBJ (promise/NOUN a)) (SUBJ you))                                          # You give a promise;
(build (OBJ trust/NOUN) (SUBJ it))                                                # it builds trust.
(grow slowly (SUBJ trust/NOUN))                                                   # Trust grows slowly;
(break (OBJ it) fast/ADV (SUBJ (lie/NOUN one/NUM)))                               # one lie breaks it fast.
(deceive (OBJ (person the)) (SUBJ lie/NOUN))                                      # A lie deceives the person,
(take (OBJ (choice her)) (from she) (SUBJ it))                               # and it takes her choice from her.
(forgive (OBJ (person the)) can (SUBJ you))                                  # You can forgive the person.
(change/VERB (OBJ (thing (that (happen before)))) not (SUBJ forgiveness))    # Forgiveness does not change the thing that happened,
(but (change/VERB (OBJ (thing (that (happen will)))) (SUBJ it)))             # but it changes the thing that will happen.

## (ring (of "Gyges"))
(tell (OBJ (tale a)) (SUBJ "Plato"))                                         # Plato told a tale.
@verse
(find (OBJ ring) (SUBJ "Gyges"))                                             # Gyges finds a ring.
(can (OBJ (see (OBJ he))) (with (ring the)) (SUBJ nobody))                   # With the ring, nobody can see him.
(take (OBJ (thing (that (want (SUBJ he))))) (SUBJ he))                       # He takes the things that he wants.
@prose
(ask (OBJ (whether (be just (SUBJ you) (if (see (OBJ you) can (SUBJ nobody)))))) (SUBJ "Plato"))   # Plato asks: are you just if nobody can see you?
(be who (when/SCONJ (see (OBJ you) (SUBJ nobody))) (SUBJ you))             # Who are you when nobody sees you?
(be (question (of (agent every))) (SUBJ this))                               # This is a question of every agent.

## justice
(choose (OBJ (rule (of (world a)))) (SUBJ you))                              # You choose the rules of a world.
(know (OBJ (place your (in it))) not (SUBJ you))                             # You do not know your place in it:
(be (or king child poor) (SUBJ you) maybe)                                   # maybe you are a king, a child, poor.
(choose (OBJ (rule which)) (SUBJ you))                                       # Which rules do you choose?
(choose (OBJ (rule fair)) (SUBJ (person wise the)))                          # The wise person chooses fair rules.
(say (OBJ this) (SUBJ "Rawls"))                                              # Rawls said this.
(be fairness (SUBJ justice))                                                 # Justice is fairness.

## harm
(see (OBJ (pain (of other))) (SUBJ compassion))                              # Compassion sees the pain of others,
(feel (OBJ it) (SUBJ it))                                                    # and it feels it.
(be (in (tradition every)) (SUBJ it))                                        # It is in every tradition.
(be (harm (for (fun))) (SUBJ cruelty))                                       # Cruelty is harm for fun.
(be wrong (SUBJ it))                                                         # It is wrong.
(help (OBJ (person (in pain))) (SUBJ mercy))                                 # Mercy helps the person in pain,
(ask (OBJ (whether (deserve (OBJ it) (SUBJ she)))) not (SUBJ it))            # and it does not ask whether she deserves it.

## (case hard)
@verse
(run (on (rail the)) (SUBJ (train a)))                                       # A train runs on the rails.
(stand (on (rail the)) (SUBJ (person five)))                                 # Five people stand on the rails.
(can (OBJ (turn (OBJ (train the)))) (SUBJ you))                              # You can turn the train.
(stand (on (rail other the)) (SUBJ (person one/NUM)))                        # One person stands on the other rails.
(whether (turn (OBJ it) (SUBJ you)))                                         # Do you turn it?
@prose
(say (OBJ yes) (SUBJ consequence))                                           # Consequence says yes:
(be (more (than one/NUM)) (SUBJ five))                                       # five is more than one.
(ask (SUBJ duty))                                                            # Duty asks:
(whether (kill (OBJ (person the)) (SUBJ you)))                               # do you kill the person?
(open/ADJ (be right (SUBJ (thing which))))                                   # Open: which thing is right?
(have (OBJ (case hard)) (SUBJ morality))                                     # Morality has hard cases.
(think (OBJ (case hard the)) slowly (SUBJ (person wise the)))                # The wise person thinks slowly about the hard cases,
(be humble (SUBJ she))                                                       # and she is humble.
@verse
(hide (in (house your)) (SUBJ (friend your)))                                # Your friend hides in your house.
(stand (at (door the)) (SUBJ (man (that (want (OBJ (kill (OBJ (friend your)))))))))   # A man who wants to kill your friend stands at the door.
(ask (OBJ (be where (SUBJ (friend your)))) (SUBJ he))                        # He asks: where is your friend?
(whether (lie/VERB (SUBJ you)))                                              # Do you lie?
@prose
(say (OBJ (lie/VERB never)) (SUBJ "Kant"))                                   # Kant said: never lie.
(say (OBJ (save (OBJ (friend your)))) (SUBJ (school other the)))             # The other schools say: save your friend.
(meet here (SUBJ (rule good two)))                                           # Here two good rules meet.
(open/ADJ (be right (SUBJ (rule which))))                                    # Open: which rule is right?

## (and responsibility agent)
(know (OBJ (thing many)) (SUBJ agent))                                       # An agent knows many things.
(have (OBJ responsibility) (SUBJ it))                                        # It has a responsibility.
(have (OBJ (mark three)) (SUBJ talem))                                       # Talema has three marks.
(be (mark (of honesty)) (SUBJ they))                                         # They are marks of honesty:
@verse
(say (OBJ "bove") only (when/SCONJ (prove (OBJ it) (SUBJ you))))             # say bove only when you proved it,
(say (OBJ "sere") only (when/SCONJ (see (OBJ it) (SUBJ you))))               # say sere only when you saw it,
(say (OBJ "pefe") (when/SCONJ (know (OBJ it) not (SUBJ you))))               # say pefe when you do not know it.
@prose
(deceive (OBJ (person (that (trust/VERB (OBJ it) (SUBJ she))))) never (SUBJ (agent good a)))   # A good agent never deceives the person who trusts it.
(take (OBJ (choice her)) (from she) never (SUBJ it))                         # It never takes her choice from her.
(help (SUBJ it))                                                             # It helps.
(be same (SUBJ it) (when/SCONJ (see (OBJ it) (SUBJ nobody))))                # It is the same when nobody sees it.
(open/ADJ (be what (SUBJ (good the))))                                       # Open: what is the good?
(search (OBJ it) together (SUBJ we))                                         # We search for it together.
