# Field chapter 5 · Philosophy. Mostly tales and questions, as philosophy mostly is; its answers carry pef.
# Each school speaks through its tale: the cave, the river, the doubter, the butterfly, the ship.
## philosophy

(begin (in wonder/NOUN) (SUBJ philosophy))                                        # Philosophy begins in wonder.
(love (OBJ wisdom) (SUBJ philosopher))                                       # A philosopher loves wisdom.
(ask (OBJ (question old the)) again/ADV (SUBJ it))                           # It asks the old questions again:
@verse
(be what (SUBJ (world the)))                                                 # What is the world?
(can (OBJ (know what)) (SUBJ we))                                            # What can we know?
(be what (SUBJ mind))                                                        # What is a mind?
(must (OBJ (do what)) (SUBJ we))                                             # What must we do?
@prose
(have (OBJ (mark "pefe")) (SUBJ (answer many (of philosophy))))              # Many answers of philosophy have the mark pefe.
(be bad not (SUBJ this))                                                     # This is not bad:
(be (life (of philosophy)) (SUBJ (question the)))                            # the question is the life of philosophy.
(say (OBJ (thought (of people many))) (in talem) (SUBJ (book this)))        # This book says the thoughts of many people in Talema.
(be (word our) (SUBJ (word the)))                                            # The words are our words;
(be (thought their) (SUBJ (thought the)))                                    # the thoughts are theirs.
(read (OBJ (book own their)) (for (word own their)))                         # For their own words, read their own books.

## wonder/NOUN
(say (OBJ (know (OBJ nothing) (SUBJ I))) (SUBJ "Socrates"))                  # Socrates said: I know nothing.
(know (OBJ this) (SUBJ I))                                                   # This I know.
(ask (OBJ (question many)) (DAT people) (in (street (of "Athens"))) (SUBJ he))   # He asked people many questions in the streets of Athens.
(think (SUBJ they) (that/SCONJ (know (OBJ (be what (SUBJ justice))) (SUBJ they))))   # They thought that they knew what justice is.
(ask (OBJ why) (SUBJ he))                                                    # He asked why,
(know (OBJ it) not (SUBJ they))                                              # and they did not know it.
(be (form/NOUN (of philosophy) first/ADJ the) (SUBJ dialogue))               # Dialogue is the first form of philosophy.
(think (in dialogue) (SUBJ talem) too)                                       # Talema thinks in dialogue too.

## being
@verse
(can (OBJ (step/VERB (in (river same)) twice)) not (SUBJ you))                            # You cannot step in the same river twice.
(say (OBJ this) before (SUBJ "Heraclitus"))                                  # Heraclitus said this.
@prose
(change/VERB (SUBJ (thing every)))                                           # Every thing changes.
(be new (SUBJ (water the)))                                                  # The water is new,
(be new (SUBJ you))                                                          # and you are new.
(stay what (SUBJ (thing every)) (when/SCONJ (change/VERB (SUBJ it))))        # What stays when a thing changes?
@verse
(change/VERB (OBJ (piece (of wood) every (of ship))) (one/NUM (after one/NUM)) (SUBJ they))   # They change every piece of wood of a ship, one after one.
(whether (be (ship same the) (SUBJ it)))                                     # Is it the same ship?
(build (OBJ (ship second/ADJ a)) (from (piece old the)) (SUBJ they))         # They build a second ship from the old pieces.
(be (ship (of "Theseus")) which (SUBJ it))                                   # Which is the ship of Theseus?
@prose
(open/ADJ (be what (SUBJ identity)))                                         # Open: what is identity?
(ask (OBJ (be why (SUBJ something))) (SUBJ "Leibniz"))                     # Leibniz asked: why is there something,
(ask (OBJ (be why not (SUBJ nothing))) (SUBJ he))                            # and not nothing?
(open/ADJ (be why (SUBJ something)))                                         # Open: why is there something?

## (and reality appearance)
(tell (OBJ (tale a)) (SUBJ "Plato"))                                         # Plato told a tale.
@verse
(live (in cave) (with chain) (SUBJ people))                                  # People live in a cave, with chains.
(see (OBJ (shadow (on wall))) only (SUBJ they))                              # They see only shadows on a wall.
(think (SUBJ they) (that/SCONJ (be (world the) (SUBJ (shadow the)))))        # They think that the shadows are the world.
(go (out (of cave)) (SUBJ (person one/NUM)))                                 # One person goes out of the cave.
(see (OBJ (sun the)) (SUBJ she))                                             # She sees the sun.
(return/VERB (to (cave the)) (SUBJ she))                                          # She returns to the cave.
(say (OBJ (be shadow (SUBJ (thing (that (see (SUBJ you))))))) (SUBJ she))    # She says: the things that you see are shadows.
(believe (OBJ she) not (SUBJ they))                                          # They do not believe her.
@prose
(be (world the) not always (SUBJ appearance))                                # Appearance is not always the world.
(see (OBJ (world the)) (through (form/NOUN own our)) (SUBJ we))              # We see the world through our own forms.
(be (form/NOUN (of mind) two) (SUBJ (and space time)))                       # Space and time are two forms of the mind.
(say (OBJ this) (SUBJ "Kant"))                                               # Kant said this.

## (and knowledge doubt)
(doubt/VERB (OBJ (thing every)) (SUBJ "Descartes"))                               # Descartes doubted every thing.
(be dream maybe (SUBJ (world the)))                                          # Maybe the world is a dream.
(lie/VERB (to he) maybe (SUBJ (sense his)))                                 # Maybe his senses lie to him.
(doubt/VERB but (SUBJ he))                                                   # But he doubts.
(think therefore (SUBJ he))                                                  # Therefore he thinks.
@verse
(think (SUBJ I))                                                             # I think,
(be therefore (SUBJ I))                                                      # therefore I am.
@prose
(see (OBJ (thing one/NUM (after (thing other)))) (SUBJ we))                  # We see one thing after another thing.
(see (OBJ cause) never (SUBJ we))                                            # We never see the cause.
(say (OBJ this) (SUBJ "Hume"))                                               # Hume said this.
(whether (rise tomorrow (SUBJ (sun the))))                                   # Will the sun rise tomorrow?
(see (OBJ it) (in (day every)) (SUBJ we))                                    # We saw it every day;
(prove (OBJ it) not (SUBJ this))                                             # this does not prove it.
(be (belief true (with justification)) maybe (SUBJ knowledge))              # Maybe knowledge is a true belief with justification.
(open/ADJ (be what (SUBJ knowledge)))                                        # Open: what is knowledge?

## mind
(dream/VERB (SUBJ "Zhuangzi") (that/SCONJ (be butterfly (SUBJ he))))              # Zhuangzi dreamed that he was a butterfly.
(fly (among flower) happy (SUBJ he))                                         # He flew among the flowers, happy.
(wake (SUBJ he))                                                             # He woke.
(know (OBJ (whether (or (dream/VERB (SUBJ (man a)) (that/SCONJ (be butterfly (SUBJ he)))) (dream/VERB (SUBJ (butterfly a)) (that/SCONJ (be man (SUBJ it))))))) not (SUBJ he))   # He did not know: did a man dream that he was a butterfly, or does a butterfly dream that it is a man?
@verse
(open/ADJ (be what (SUBJ consciousness)))                                    # Open: what is consciousness?
(open/ADJ (feel why (SUBJ (thing some))))                                    # Open: why do some things feel?
(open/ADJ (be one/NUM (SUBJ (and mind body))))                               # Open: are mind and body one?
(open/ADJ (feel (SUBJ (mind (of number)))))                                  # Open: does a mind of numbers feel?
@prose
(read (OBJ (question last the)) slowly (SUBJ you))                           # Read the last question slowly.
(be (question your) (SUBJ it) maybe)                                         # Maybe it is your question.
(whether (choose (OBJ (act/NOUN our)) (SUBJ we)))                            # Do we choose our acts?
(be (effect (of (cause other))) (SUBJ (cause every)) (if (be true (SUBJ determinism))))   # If determinism is true, every cause is the effect of another cause.
(be where then (SUBJ freedom))                                               # Where is freedom then?
(open/ADJ (whether (be free (SUBJ (will/NOUN the)))))                                   # Open: is the will free?

## language
(be (limit/NOUN (of (world my))) (SUBJ (limit/NOUN (of (language my)))))     # The limits of my language are the limits of my world.
(write (OBJ this) (SUBJ "Wittgenstein"))                                     # Wittgenstein wrote this.
(be (in silence) must (SUBJ we) (about (thing (that (speak (about it) can not (SUBJ we))))))   # About what we cannot speak, we must be in silence.
(write (OBJ this) too (SUBJ he))                                             # He wrote this too.
(grow (SUBJ (language this)))                                                # This language grows,
(grow (SUBJ (world its)))                                                    # and its world grows.
(write (OBJ (word new)) can (SUBJ you))                                      # You can write new words.

(love (OBJ (question the)) (more (than (answer the))) (SUBJ philosopher))    # A philosopher loves the question more than the answer.
