# The play · Scene 9, the lesson. Rosa teaches Yuki a phrase. A learner who does not understand and is told it again, simpler; a mistake that becomes a joke; praise that is short; a rule that starts with if; and a thanks that is turned into work.
## (scene nine)

(sit (with "Rosa") (SUBJ "Yuki"))                                            # Yuki sits with Rosa.
@verse
("Yuki")
(please (teach (OBJ (phrase a)) (DAT I)))                                    # Please teach me a phrase.
("Rosa")
(phrase which/DET)                                                           # Which phrase?
("Yuki")
(say (OBJ (be hungry (SUBJ I))) how (SUBJ I))                                # How do I say: I am hungry?
("Rosa")
(say (OBJ (be hungry (SUBJ I))))                                             # Say: I am hungry.
("Yuki")
(be hungry (SUBJ I))                                                         # I am hungry.
("Rosa")
(good/ADJ)                                                                   # Good.
(say now (OBJ (want (OBJ bread) (SUBJ I))))                                  # Now say: I want bread.
("Yuki")
(want (OBJ bread) (SUBJ I))                                                  # I want bread.
("Rosa")
(yes/INTJ)                                                                   # Yes.
(say (OBJ it) again/ADV slowly)                                              # Say it again, slowly.
("Yuki")
(huh/INTJ)                                                                   # Huh?
(understand (OBJ it) not (SUBJ I))                                           # I do not understand.
("Rosa")
(be easy (SUBJ it))                                                          # It is easy.
(word one)                                                                   # One word.
(listen)                                                                     # Listen.
(bread)                                                                      # Bread.
("Yuki")
(bread)                                                                      # Bread.
("Rosa")
(good/ADJ)                                                                   # Good.
(whether (understand (OBJ it) (SUBJ you)))                                   # Do you understand?
("Yuki")
(understand (OBJ it) little (SUBJ I))                                        # I understand a little.
("Rosa")
(be right (SUBJ you))                                                        # You are right.
(say (OBJ (want (OBJ bread))))                                               # Say: want bread.
("Yuki")
(be hungry (SUBJ (bread the)))                                               # The bread is hungry.
("Rosa")
(ha/INTJ)                                                                    # Ha!
(be hungry not (SUBJ (bread the)))                                           # The bread is not hungry.
(be hungry (SUBJ you))                                                       # You are hungry.
("Yuki")
(oh/INTJ)                                                                    # Oh.
(be hungry (SUBJ I))                                                         # I am hungry.
(be hungry not (SUBJ (bread the)))                                           # The bread is not.
(sorry/INTJ)                                                                 # Sorry.
("Rosa")
(be sorry/ADJ not)                                                           # Do not be sorry.
(be (mistake good a) (SUBJ it))                                              # It is a good mistake.
@prose
(come (SUBJ "Deniz"))                                                        # Deniz comes.
@verse
("Deniz")
(know (OBJ (word one)) (SUBJ I))                                             # I know one word.
(tea)                                                                        # Tea.
("Rosa")
(be (word good a) (SUBJ it))                                                 # It is a good word.
("Ada")
(know (OBJ (word many)) (SUBJ I))                                            # I know many words!
("Rosa")
(word which/DET)                                                             # Which words?
("Ada")
(why)                                                                        # Why?
(why)                                                                        # Why?
(why)                                                                        # Why?
("Rosa")
(be (word one) (SUBJ it))                                                    # That is one word.
("Ada")
(be (word my good) (SUBJ it))                                                # It is my good word.
("Yuki")
(whether (know (OBJ it) (SUBJ I)))                                           # Do I know it?
("Rosa")
(know (OBJ it) (if (say (OBJ it) (in (day every)) (SUBJ you))) (SUBJ you))   # If you say it every day, you know it.
("Yuki")
(say (OBJ it) (in (day every)) will (SUBJ I))                                # I will say it every day.
("Rosa")
(ask (if (forget (SUBJ you))))                                               # If you forget, ask.
("Yuki")
(ask (OBJ you) will (SUBJ I))                                                # I will ask you.
(thanks/NOUN (to "Rosa"))                                                    # Thanks, Rosa.
("Rosa")
(thank (OBJ I) not)                                                          # Do not thank me.
(work/VERB hard/ADV (SUBJ you))                                              # You work hard.
