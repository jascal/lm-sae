# The play · Scene 1, the rain. Sol and Nima are wet; Kofi says one word at a time; Tomas is late, or early.
## (scene first/ADJ the)

(fall (in (morning the)) (SUBJ (rain the)))                                  # In the morning the rain falls.
(be wet (SUBJ (market the)))                                                 # The market is wet.
@verse
("Sol")
(hello/INTJ (to "Nima"))                                                     # Hello, Nima!
("Nima")
(hello/INTJ (to "Sol"))                                                      # Hello, Sol.
("Sol")
(come early/ADV (SUBJ you))                                                  # You come early.
("Nima")
(sleep not (SUBJ I))                                                         # I did not sleep.
(be (and wet cold) (SUBJ I))                                                 # I am wet and cold.
("Sol")
(oh/INTJ)                                                                    # Oh.
(sorry/INTJ)                                                                 # Sorry.
(please (sit here))                                                          # Please sit here.
(be warm (SUBJ (bread this)))                                                # This bread is warm.
("Nima")
(nah/INTJ)                                                                   # Nah.
(thanks/NOUN)                                                                # Thanks.
(have (OBJ (work/NOUN a)) (SUBJ I))                                          # I have work.
("Sol")
(be (work/NOUN hard a) (SUBJ it))                                            # It is hard work.
("Nima")
(wait/VERB not (SUBJ (apple the)))                                           # The apples do not wait.
("Sol")
(ha/INTJ)                                                                    # Ha!
(be tired not (SUBJ (apple the)))                                            # The apples are not tired.
(but (be tired (SUBJ you)))                                                  # But you are tired.
("Nima")
(well/ADV)                                                                   # Well.
(maybe/ADV)                                                                  # Maybe.
(okay/INTJ)                                                                  # Okay.
(please (give (OBJ (bread the)) (DAT I)))                                    # Please give me the bread.
("Sol")
(here)                                                                       # Here.
(be warm (SUBJ it))                                                          # It is warm.
@prose
(eat (OBJ (bread the)) (SUBJ "Nima"))                                        # Nima eats the bread.
@verse
("Nima")
(be good (SUBJ (bread the)))                                                 # The bread is good.
("Sol")
(know (OBJ it) (SUBJ I))                                                     # I know it.
("Nima")
(be proud (SUBJ you))                                                        # You are proud.
("Sol")
(yes/INTJ)                                                                   # Yes.
(be proud (SUBJ I))                                                          # I am proud.
(be good (SUBJ (bread my)))                                                  # My bread is good.
@prose
(come (SUBJ "Kofi"))                                                         # Kofi comes.
@verse
("Kofi")
(fish)                                                                       # Fish.
("Sol")
(hello/INTJ (to "Kofi"))                                                     # Hello, Kofi.
(be how (SUBJ (fish the)))                                                   # How is the fish?
("Kofi")
(fresh/ADJ)                                                                  # Fresh.
("Sol")
(talk/VERB always (SUBJ you))                                                # You always talk.
("Kofi")
(nah/INTJ)                                                                   # Nah.
("Nima")
(ha/INTJ)                                                                    # Ha!
@prose
(come slowly (SUBJ "Tomas"))                                                 # Tomas comes slowly.
@verse
("Tomas")
(well/ADV)                                                                   # Well.
(morning good)                                                               # Good morning.
("Sol")
(morning good (to "Tomas"))                                                  # Good morning, Tomas.
("Tomas")
(be (or early/ADV late/ADV) (SUBJ I))                                        # I am early or late.
(know (OBJ it) not (SUBJ I))                                                 # I do not know.
("Nima")
(be late/ADV always (SUBJ you))                                              # You are always late.
("Tomas")
(maybe/ADV)                                                                  # Maybe.
(be early/ADV maybe (SUBJ (rain the)))                                       # Maybe the rain is early.
("Kofi")
(yes/INTJ)                                                                   # Yes.
("Sol")
(ha/INTJ)                                                                    # Ha!
("Tomas")
(sit where (SUBJ I))                                                         # Where do I sit?
("Sol")
(please (sit here))                                                          # Please sit here.
("Tomas")
(thank (OBJ you) (SUBJ I))                                                   # I thank you.
@prose
(fall (SUBJ (rain the)))                                                     # The rain falls.
(open (SUBJ (market the)))                                                   # The market opens.
