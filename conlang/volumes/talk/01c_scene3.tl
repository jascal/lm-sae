# The play · Scene 3, the apples. Ada asks why, and why, and why; Nima runs out of answers, and smiles.
## (scene third/ADJ the)

(come (with "Ada") (SUBJ "Lena"))                                            # Lena comes with Ada.
@verse
("Ada")
(hello/INTJ)                                                                 # Hello!
(be what (SUBJ this))                                                        # What is this?
("Nima")
(apple a)                                                                    # An apple.
("Ada")
(be red why (SUBJ it))                                                       # Why is it red?
("Lena")
(please (wait/VERB) (to "Ada"))                                              # Ada, please wait.
(sorry/INTJ (to "Nima"))                                                     # Sorry, Nima.
(ask always (SUBJ she))                                                      # She always asks.
("Nima")
(be fine (SUBJ it))                                                          # It is fine.
(make/VERB (OBJ it) red (SUBJ (sun the)))                                    # The sun makes it red.
("Ada")
(why)                                                                        # Why?
("Nima")
(know (OBJ it) not (SUBJ I))                                                 # I do not know.
("Ada")
(know (OBJ it) (SUBJ who))                                                   # Who knows?
("Nima")
(know (OBJ it) (SUBJ nobody))                                                # Nobody knows.
("Ada")
(know (OBJ it) (SUBJ (sun the)))                                             # The sun knows.
("Nima")
(maybe/ADV)                                                                  # Maybe.
("Lena")
(be (answer good a) (SUBJ it))                                               # It is a good answer.
("Ada")
(whether (can (OBJ (have (OBJ (apple a)) (SUBJ I))) (SUBJ I)))               # Can I have an apple?
("Lena")
(pay first/ADV (SUBJ we))                                                    # We pay first.
("Nima")
(be (coin one) (SUBJ (apple one)))                                           # One apple is one coin.
("Lena")
(please (give (OBJ (apple two)) (DAT I)))                                    # Two apples, please.
@prose
(give (OBJ (coin two)) (DAT "Nima") (SUBJ "Lena"))                           # Lena gives Nima two coins.
(give (OBJ (apple three)) (DAT "Lena") (SUBJ "Nima"))                        # Nima gives Lena three apples.
@verse
("Lena")
(whether (be (apple three) (SUBJ it)))                                       # Is it three apples?
("Nima")
(three/NUM)                                                                  # Three.
(take (OBJ it))                                                              # Take it.
("Lena")
(thank (OBJ you) (SUBJ I))                                                   # I thank you.
("Ada")
(thanks/NOUN)                                                                # Thanks!
("Sol")
(smile/VERB (SUBJ "Nima"))                                                        # Nima smiles!
("Nima")
(nah/INTJ)                                                                   # Nah.
(smile/VERB not (SUBJ I))                                                         # I do not smile.
("Ada")
(smile/VERB (SUBJ you))                                                           # You smile.
@prose
(laugh/VERB (SUBJ "Lena"))                                                   # Lena laughs.
@verse
("Ada")
(why)                                                                        # Why?
("Nima")
(smile/VERB (because (be good (SUBJ (apple the)))) (SUBJ I))                      # I smile because the apples are good.
(tell (OBJ it) not (to "Sol"))                                               # Do not tell Sol.
("Sol")
(hear (OBJ you) (SUBJ I))                                                    # I hear you!
("Nima")
(ha/INTJ)                                                                    # Ha!
