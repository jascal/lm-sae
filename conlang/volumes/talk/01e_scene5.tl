# The play · Scene 5, the end of the day. The rain stops; they count the day, promise to come back, and Kofi says a sentence.
## (scene fifth/ADJ the)

(stop/VERB (SUBJ (rain the)))                                                # The rain stops.
(come (SUBJ (sun the)))                                                      # The sun comes.
@verse
("Sol")
(look (OBJ (sun the)))                                                       # Look at the sun!
("Nima")
(be good (for (apple many)) (SUBJ (sun the)))                                # The sun is good for apples.
(be good also (for (apple many)) (SUBJ (rain the)))                          # The rain is good for apples, too.
("Sol")
(whether (be happy (SUBJ you)))                                              # Are you happy?
("Nima")
(be happy not (SUBJ I))                                                      # I am not happy.
(be glad (SUBJ I))                                                           # I am glad.
("Sol")
(ha/INTJ)                                                                    # Ha!
(be how (SUBJ (day the)))                                                    # How was the day?
("Tomas")
(well/ADV)                                                                   # Well.
(be good (SUBJ (day the)))                                                   # It was a good day.
("Kofi")
(fish)                                                                       # Fish.
(be fine (SUBJ it))                                                          # It is fine.
("Nima")
(have (OBJ (apple no)) now (SUBJ I))                                         # I have no apples now.
("Sol")
(have (OBJ (bread no)) now (SUBJ I))                                         # I have no bread now.
("Omar")
(be hungry not (SUBJ "Pip"))                                                 # Pip is not hungry.
("Yuki")
(thanks/NOUN)                                                                # Thanks.
(know (OBJ (name four)) now (SUBJ I))                                        # I know four names now.
("Omar")
(and (dog a))                                                                # And a dog.
("Yuki")
(five/NUM)                                                                   # Five.
("Tomas")
(come early/ADV will tomorrow/NOUN (SUBJ I))                                 # Tomorrow I will come early.
("Nima")
(come early/ADV never (SUBJ you))                                            # You never come early.
("Tomas")
(whether (never/ADV))                                                        # Never?
(well/ADV)                                                                   # Well.
(maybe/ADV)                                                                  # Maybe.
@prose
(come (with "Ada") (SUBJ "Lena"))                                            # Lena comes with Ada.
@verse
("Ada")
(goodbye/NOUN (to "Nima"))                                                   # Goodbye, Nima!
("Nima")
(bye/INTJ (to "Ada"))                                                        # Bye, Ada.
(come again/ADV)                                                             # Come again.
("Yuki")
(goodbye/NOUN)                                                               # Goodbye.
(come again/ADV will (SUBJ I))                                               # I will come again.
("Sol")
(come tomorrow/NOUN)                                                         # Come tomorrow.
(come (with (dog the)))                                                      # Come with the dog.
("Omar")
(yes/INTJ)                                                                   # Yes!
@prose
(smile/VERB (SUBJ "Kofi"))                                                        # Kofi smiles.
@verse
("Kofi")
(say (OBJ goodbye/NOUN) (SUBJ (fish the)))                                   # The fish says goodbye.
("Sol")
(talk/VERB (SUBJ "Kofi"))                                                    # Kofi talks!
("Kofi")
(fish)                                                                       # Fish.
@prose
(close (SUBJ (market the)))                                                  # The market closes.
(end/VERB (SUBJ (play/NOUN the)))                                            # The play ends.
