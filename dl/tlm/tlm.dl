// Type–Link–Merge (TLM) grammar — the universal grammar of docs/UNIVERSAL_GRAMMAR.md as Soufflé Datalog.
// SOURCE OF TRUTH for the prototype: the python driver (scripts/grammar/tlm.py) only stages facts and prints
// what this program derives; `tlm.py gate` proves the Link and Merge rules equal to the python trees the
// measurements were made with (scripts/grammar/ug_trees.py).
//
// Three rules, one parameter:
//   TYPE   every word gets features from a small universal space: referent ↔ relator, content ↔ function
//   LINK   every word has exactly one head; RELATORS (adpositions/case markers, subordinators) head what
//          they introduce; determiners and auxiliaries do not
//   MERGE  a head combines with its dependents one at a time — complements, then adjuncts, then the
//          subject, nearest first; no bar levels, no empty projections
//   ORDER  word order is a per-language choice, derived here as statistics, not stipulated
//
// s = sentence id, i = 1-based word index, head 0 = root (CoNLL-U conventions). rel = UD relation, subtype stripped.
// Every `count` names every variable (single-use ones as `_x`): over a join, Soufflé treats `_` as existential and
// counts distinct bindings of the named variables only (a `_` there turned link counts into sentence counts in an
// earlier draft). `_x` is a real variable that Soufflé does not warn about.

.decl word(s:number, i:number, form:symbol, upos:symbol, head:number, rel:symbol)
.input word(IO=file, filename="word.facts")
.decl lang(s:number, l:symbol)
.input lang(IO=file, filename="lang.facts")
// measured register: each category's mean coordinate on the two shared type axes (4 LLMs, 13 languages;
// axis 1 = referent(+) ↔ relator(−), axis 2 = content(+) ↔ function(−); generated by tlm.py from runs/grammar)
.decl type_axis(upos:symbol, a1:float, a2:float)
.input type_axis(IO=file, filename="type_axis.facts")

// ── measured registers of the LINK and MERGE rules ────────────────────────────────────────────────────
.decl relator_rel(r:symbol)      // promoted to head: P (case) 40/52 cells, C (mark) 45/52
relator_rel("case"). relator_rel("mark").
.decl nonhead_rel(r:symbol)      // tested and NOT heads: D (det) 13/52, T (aux/cop) 25/52 — documentation only
nonhead_rel("det"). nonhead_rel("aux"). nonhead_rel("cop").
.decl comp_rel(r:symbol)         // complements merge first
comp_rel("obj"). comp_rel("iobj"). comp_rel("ccomp"). comp_rel("xcomp"). comp_rel("_fcomp").
.decl spec_rel(r:symbol)         // the subject merges last
spec_rel("nsubj"). spec_rel("csubj"). spec_rel("expl").

// ═══ RULE 1 · TYPE ════════════════════════════════════════════════════════════════════════════════════
.decl type_of(s:number, i:number, ref:symbol, lex:symbol)
.output type_of
type_of(s, i, "referent", "content")  :- word(s, i, _, u, _, _), type_axis(u, a, b), a >= 0, b >= 0.
type_of(s, i, "referent", "function") :- word(s, i, _, u, _, _), type_axis(u, a, b), a >= 0, b < 0.
type_of(s, i, "relator", "content")   :- word(s, i, _, u, _, _), type_axis(u, a, b), a < 0, b >= 0.
type_of(s, i, "relator", "function")  :- word(s, i, _, u, _, _), type_axis(u, a, b), a < 0, b < 0.
type_of(s, i, "none", "none")         :- word(s, i, _, u, _, _), !type_axis(u, _, _).   // PUNCT, SYM, X, INTJ

// ═══ RULE 2 · LINK (relator heads) ════════════════════════════════════════════════════════════════════
.decl relator_of(s:number, c:number, f:number)          // f is a relator of content word c
relator_of(s, c, f) :- word(s, f, _, _, c, r), relator_rel(r), c != 0.
// chain order: farther from c is higher; ties → lower index higher. key grows with height.
.decl rkey(s:number, c:number, f:number, k:number)
rkey(s, c, f, max(f - c, c - f) * 10000 - f) :- relator_of(s, c, f).
.decl rtop(s:number, c:number, f:number)
rtop(s, c, f) :- rkey(s, c, f, k), k = max k2 : { rkey(s, c, _, k2) }.
.decl rbottom(s:number, c:number, f:number)
rbottom(s, c, f) :- rkey(s, c, f, k), k = min k2 : { rkey(s, c, _, k2) }.
.decl rup(s:number, c:number, f:number, g:number)      // g is the next relator above f
rup(s, c, f, g) :- rkey(s, c, f, kf), rkey(s, c, g, kg), kg = min k2 : { rkey(s, c, _, k2), k2 > kf }.

.decl moved(s:number, i:number)
moved(s, c) :- relator_of(s, c, _).
moved(s, f) :- relator_of(s, _, f).

.decl link(s:number, i:number, h:number, rel:symbol)    // the TLM head of every word
.output link
link(s, i, h, r)          :- word(s, i, _, _, h, r), !moved(s, i).
link(s, c, f, "_fcomp")   :- rbottom(s, c, f).                            // content word hangs from its relator
link(s, f, g, "_fcomp")   :- rup(s, _, f, g).                             // relator chain
link(s, f, h, r)          :- rtop(s, c, f), word(s, c, _, _, h, r).       // top relator takes c's place

// ═══ RULE 3 · MERGE (binary, no bar levels) ═══════════════════════════════════════════════════════════
.decl dep(s:number, h:number, d:number, key:number)     // merge order key: class, then distance, then index
dep(s, h, d, 0 * 1000000 + max(d - h, h - d) * 1000 + d) :- link(s, d, h, r), h != 0, comp_rel(r).
dep(s, h, d, 1 * 1000000 + max(d - h, h - d) * 1000 + d) :- link(s, d, h, r), h != 0, !comp_rel(r), !spec_rel(r).
dep(s, h, d, 2 * 1000000 + max(d - h, h - d) * 1000 + d) :- link(s, d, h, r), h != 0, spec_rel(r).
.decl step(s:number, h:number, d:number, k:number)      // d is merged with h at step k (1-based)
step(s, h, d, n + 1) :- dep(s, h, d, key), n = count : { dep(s, h, _e, k2), k2 < key }.
.decl ndeps(s:number, h:number, n:number)
ndeps(s, h, n) :- word(s, h, _, _, _, _), n = count : { dep(s, h, _d, _key) }.
.decl maxproj(s:number, h:number, k:number)             // a word's maximal projection is its last merge node
maxproj(s, h, n) :- ndeps(s, h, n).

// merge node (h, k): k = 0 is the word itself; (h, k) = Merge((h, k-1), maxproj(d_k))
.decl merge_edge(s:number, h:number, k:number, ch:number, ck:number)
.output merge_edge
merge_edge(s, h, k, h, k - 1) :- step(s, h, _, k).
merge_edge(s, h, k, d, kd)    :- step(s, h, d, k), maxproj(s, d, kd).

.decl covers(s:number, h:number, k:number, w:number)
covers(s, h, 0, h) :- word(s, h, _, _, _, _).
covers(s, h, k, w) :- merge_edge(s, h, k, ch, ck), covers(s, ch, ck, w).
.decl node(s:number, h:number, k:number)
node(s, h, k) :- covers(s, h, k, _).
.decl span(s:number, h:number, k:number, lo:number, hi:number, size:number)
.output span
span(s, h, k, lo, hi, n) :- node(s, h, k), lo = min w : { covers(s, h, k, w) },
    hi = max w : { covers(s, h, k, w) }, n = count : { covers(s, h, k, _w) }.

// ═══ ORDER · the per-language linearisation parameter ═════════════════════════════════════════════════
// for each language and relation: how often the head precedes the dependent in the TLM tree
.decl head_first(s:number, i:number, r:symbol)
head_first(s, i, r) :- link(s, i, h, r), h != 0, h < i.
.decl order_stat(l:symbol, rel:symbol, head_first:number, total:number)
.output order_stat
.decl lang_rel(l:symbol, r:symbol)     // distinct (language, relation) keys: aggregate once per key, not per link
lang_rel(l, r) :- lang(s, l), link(s, _, _, r), (r = "_fcomp"; r = "obj"; r = "nsubj"; r = "amod"; r = "det").
order_stat(l, r, hf, n) :- lang_rel(l, r),
    n = count : { lang(s, l), link(s, _d, h, r), h != 0 },
    hf = count : { lang(s, l), head_first(s, _d, r) }, n > 0.

// ═══ INVARIANTS · each relation must be EMPTY ═════════════════════════════════════════════════════════
.decl bad_head_count(s:number, i:number, n:number)   // exactly one head per word
.output bad_head_count
bad_head_count(s, i, n) :- word(s, i, _, _, _, _), n = count : { link(s, i, _h, _r) }, n != 1.
.decl reach(s:number, a:number, b:number)
reach(s, i, h) :- link(s, i, h, _), h != 0.
reach(s, i, a) :- reach(s, i, m), link(s, m, a, _), a != 0.
.decl cycle(s:number, i:number)                      // links form a tree: no word is its own ancestor
.output cycle
cycle(s, i) :- reach(s, i, i).
.decl bad_root_count(s:number, n:number)             // exactly one root
.output bad_root_count
bad_root_count(s, n) :- lang(s, _), n = count : { link(s, _i, 0, _r) }, n != 1.
.decl relator_without_complement(s:number, f:number, n:number)   // a promoted relator heads exactly one _fcomp
.output relator_without_complement
relator_without_complement(s, f, n) :- relator_of(s, _, f), n = count : { link(s, _d, f, "_fcomp") }, n != 1.
.decl determiner_heads(s:number, i:number)           // rule 2: determiners never head a complement
.output determiner_heads
determiner_heads(s, i) :- word(s, i, _, _, _, r), nonhead_rel(r), link(s, _, i, "_fcomp").
.decl uncovered(s:number, w:number)                  // the root's maximal projection covers every word
.output uncovered
uncovered(s, w) :- word(s, w, _, _, _, _), link(s, r, 0, _), maxproj(s, r, k), !covers(s, r, k, w).
